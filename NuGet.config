<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- rexplayer is standalone. Clearing inherited feeds keeps the build from ever depending on a
       private source that has nothing to do with this project. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>

root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = space
trim_trailing_whitespace = true

# CRLF is the convention of the Windows project file types and nothing else.
[*.{cs,csproj,props,targets,xaml,ps1,slnx,iss,hlsl}]
end_of_line = crlf

[*.{cs,csproj,props,targets,hlsl}]
indent_size = 4

[*.xaml]
indent_size = 2

[*.{md,yml,yaml,json,js,mjs,css,html}]
indent_size = 2

[*.py]
indent_size = 4

[*.cs]
csharp_style_namespace_declarations = file_scoped:error
csharp_style_var_when_type_is_apparent = true:suggestion
dotnet_style_require_accessibility_modifiers = for_non_interface_members:error

# Rules from the recommended analysis level that this codebase turns off, each for a stated reason.
#
# CA1859 and CA1826 trade an interface for a concrete type to save a virtual call. Seams are written
# against interfaces so tests can substitute them.
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.CA1826.severity = none
# CA1720 reads media words as type names: a sample format is Single, a channel is Left.
dotnet_diagnostic.CA1720.severity = none
# CA1716 protects callers in other .NET languages. rexplayer publishes no library, so a member named
# Next or Stop collides with nothing anyone will write.
dotnet_diagnostic.CA1716.severity = none
# CA1303 asks for every literal passed to a "text" parameter to come from resources. User-facing
# strings live in the app's resource files; the engine's messages are diagnostics for logs.
dotnet_diagnostic.CA1303.severity = none
# CA1819 forbids properties returning arrays. Media code passes sample and coefficient tables as
# arrays on purpose: ReadOnlySpan views over them are what the hot paths use.
dotnet_diagnostic.CA1819.severity = none
# CA1028 wants enums backed by int. Format codes and box types are naturally 8, 16 or 32-bit
# unsigned values taken straight from the specifications.
dotnet_diagnostic.CA1028.severity = none
# CA5394 flags System.Random as insecure. Shuffle order and test noise are not security decisions.
dotnet_diagnostic.CA5394.severity = none

# Dead code fails the build. An unused private member, an unread field, an unused parameter, a
# needless using or a class nothing creates is something every reader has to work out is not there
# for a reason.
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0051.severity = warning
dotnet_diagnostic.IDE0052.severity = warning
dotnet_diagnostic.IDE0060.severity = warning
dotnet_diagnostic.CA1812.severity = warning
dotnet_diagnostic.CA1823.severity = warning

[**/obj/**.cs]
generated_code = true

# The window's event handlers are named in XAML, and dotnet format analyses the code without the
# wiring the XAML compiler generates, so it would call every one unused. The compiler, which sees
# the wiring, still reports anything truly unused in these files.
[src/Rex.Media.App/**.cs]
dotnet_diagnostic.IDE0051.severity = none
dotnet_diagnostic.IDE0060.severity = none

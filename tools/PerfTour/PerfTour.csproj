<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>Rex.PerfTour</RootNamespace>
    <AssemblyName>perf-tour</AssemblyName>
    <!-- For System.Windows.Automation, the UI Automation client the tour drives the window with. -->
    <UseWPF>true</UseWPF>
    <!-- For the LibraryImport-generated SendInput marshalling the double click uses. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Rex.Media.AppCore\Rex.Media.AppCore.csproj" />
  </ItemGroup>

</Project>

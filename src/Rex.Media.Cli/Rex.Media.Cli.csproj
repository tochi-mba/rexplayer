<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Windows' face detector, which keeps captions off faces, is a Windows 10 API, so the
         command line names a Windows platform version, as the app does. -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Rex.Media.Cli</RootNamespace>
    <AssemblyName>rexplay</AssemblyName>
    <AssemblyTitle>rexplayer command line</AssemblyTitle>
    <ApplicationIcon>..\..\assets\rexplayer.ico</ApplicationIcon>
    <SelfContained Condition="'$(RuntimeIdentifier)' != ''">true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rex.Media.Primitives\Rex.Media.Primitives.csproj" />
    <ProjectReference Include="..\Rex.Media.Diagnostics\Rex.Media.Diagnostics.csproj" />
    <ProjectReference Include="..\Rex.Media.Audio\Rex.Media.Audio.csproj" />
    <ProjectReference Include="..\Rex.Media.Audio.Wasapi\Rex.Media.Audio.Wasapi.csproj" />
    <ProjectReference Include="..\Rex.Media.Codecs.MediaFoundation\Rex.Media.Codecs.MediaFoundation.csproj" />
    <ProjectReference Include="..\Rex.Media.Video\Rex.Media.Video.csproj" />
    <ProjectReference Include="..\Rex.Media.Video.D3D11\Rex.Media.Video.D3D11.csproj" />
    <ProjectReference Include="..\Rex.Media.Interop\Rex.Media.Interop.csproj" />
    <ProjectReference Include="..\Rex.Media.AppCore\Rex.Media.AppCore.csproj" />
    <ProjectReference Include="..\Rex.Media.Faces\Rex.Media.Faces.csproj" />
    <ProjectReference Include="..\Rex.Media.Speech\Rex.Media.Speech.csproj" />
  </ItemGroup>

</Project>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The macOS .NET runtime uses a JIT. Without this entitlement the runtime aborts in
       xamarin_initialize before managed Main can run on protected user machines. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
</dict>
</plist>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- rexplayer.app: the macOS window over the same player code the Windows window uses
         (Rex.Media.AppCore), in AppKit through Microsoft's macOS SDK (ADR-0021). The one project a
         Windows machine compiles but cannot link; the macOS runner builds and bundles it. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-macos</TargetFramework>
    <!-- Keep the managed API guard and the native Mach-O deployment target in agreement. -->
    <MacOSMinimumVersion>12.0</MacOSMinimumVersion>
    <SupportedOSPlatformVersion>12.0</SupportedOSPlatformVersion>
    <RootNamespace>Rex.Media.App.Mac</RootNamespace>
    <AssemblyName>rexplayer</AssemblyName>
    <ApplicationId>com.rextechnologies.rexplayer</ApplicationId>
    <ApplicationTitle>rexplayer</ApplicationTitle>
    <ApplicationDisplayVersion>$(Version)</ApplicationDisplayVersion>
    <ApplicationVersion>$(Version)</ApplicationVersion>
    <RuntimeIdentifiers>osx-arm64;osx-x64</RuntimeIdentifiers>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rex.Media.Primitives\Rex.Media.Primitives.csproj" />
    <ProjectReference Include="..\Rex.Media.Diagnostics\Rex.Media.Diagnostics.csproj" />
    <ProjectReference Include="..\Rex.Media.IO\Rex.Media.IO.csproj" />
    <ProjectReference Include="..\Rex.Media.Audio\Rex.Media.Audio.csproj" />
    <ProjectReference Include="..\Rex.Media.Audio.CoreAudio\Rex.Media.Audio.CoreAudio.csproj" />
    <ProjectReference Include="..\Rex.Media.Codecs\Rex.Media.Codecs.csproj" />
    <ProjectReference Include="..\Rex.Media.Codecs.Apple\Rex.Media.Codecs.Apple.csproj" />
    <ProjectReference Include="..\Rex.Media.Engine\Rex.Media.Engine.csproj" />
    <ProjectReference Include="..\Rex.Media.Library\Rex.Media.Library.csproj" />
    <ProjectReference Include="..\Rex.Media.Settings\Rex.Media.Settings.csproj" />
    <ProjectReference Include="..\Rex.Media.AppCore\Rex.Media.AppCore.csproj" />
    <ProjectReference Include="..\Rex.Media.Video\Rex.Media.Video.csproj" />
    <ProjectReference Include="..\Rex.Media.Video.Metal\Rex.Media.Video.Metal.csproj" />
    <ProjectReference Include="..\Rex.Media.Speech\Rex.Media.Speech.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\\..\\CHANGELOG.md" Link="CHANGELOG.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Whisper resolves these functions from its selected runtime library. The macOS SDK would
       otherwise keep them as native-linker references, even though the library is deliberately
       loaded only when speech recognition is used. -->
  <ItemGroup>
    <ReferenceNativeSymbol Include="whisper_ctx_init_openvino_encoder_with_state" SymbolType="Function" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_free" SymbolType="Function" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_free_params" SymbolType="Function" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_free_state" SymbolType="Function" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_full_default_params_by_ref" SymbolType="Function" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_full_get_segment_no_speech_prob_from_state" SymbolType="Function" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_full_get_segment_t0_from_state" SymbolType="Function" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_full_get_segment_t1_from_state" SymbolType="Function" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_full_get_segment_text_from_state" SymbolType="Function" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_full_get_token_data_from_state" SymbolType="Function" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_full_get_token_p_from_state" SymbolType="Function" SymbolMode="Ignore" />
    <ReferenceNativeSymbol Include="whisper_full_get_token_text_from_state" SymbolType="Function" SymbolMode="Ignore" />
  </ItemGroup>

  <!-- Whisper's runtime package gives a plain net10.0 project (Rex.Media.Speech) native
       libraries for every platform, and they reach this app through that reference. The macOS
       SDK treats native files present during _ComputePublishLocation as link inputs. Remove every
       packaged runtime library before that step: foreign libraries do not belong in the app, and
       Whisper loads the matching Mac libraries itself at run time. Add only those Mac libraries
       back afterwards, before bundle resource paths are assigned, so they are copied into
       runtimes/macos-* without entering the native link. -->
  <Target Name="KeepPackagedRuntimeLibrariesOutOfTheNativeLink"
          BeforeTargets="_ComputePublishLocation">
    <ItemGroup>
      <_PackagedRuntimeLibrary Include="@(ResolvedFileToPublish)"
          Condition="$([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\\', '/').Contains('runtimes/linux-')) Or $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\\', '/').Contains('runtimes/win-')) Or $([System.String]::Copy('%(ResolvedFileToPublish.RelativePath)').Replace('\\', '/').Contains('runtimes/macos-'))" />
      <_MacRuntimeLibrary Include="@(_PackagedRuntimeLibrary)"
          Condition="$([System.String]::Copy('%(_PackagedRuntimeLibrary.RelativePath)').Replace('\\', '/').Contains('runtimes/macos-'))" />
      <ResolvedFileToPublish Remove="@(_PackagedRuntimeLibrary)" />
    </ItemGroup>
    <Message Importance="high" Condition="'@(_PackagedRuntimeLibrary)' != ''"
        Text="Kept packaged runtime libraries out of the native link: @(_PackagedRuntimeLibrary->'%(RelativePath)', ', ')" />
  </Target>

  <Target Name="PutMacRuntimeLibrariesInTheBundle"
          AfterTargets="_ComputePublishLocation"
          BeforeTargets="_ComputeBundleResourceOutputPaths">
    <ItemGroup>
      <ResolvedFileToPublish Include="@(_MacRuntimeLibrary)" />
    </ItemGroup>
    <Message Importance="high" Condition="'@(_MacRuntimeLibrary)' != ''"
        Text="Put Mac runtime libraries in rexplayer.app for run-time loading: @(_MacRuntimeLibrary->'%(RelativePath)', ', ')" />
  </Target>


</Project>

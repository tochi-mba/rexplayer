<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    x:Class="Rex.Media.App.LibraryNavigationTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Rex.Media.App">
    <DataTemplate x:Key="LibrarySourceTemplate" x:DataType="local:LibrarySourceItem">
      <Grid MinHeight="40" ColumnSpacing="12" Padding="8,6" AutomationProperties.Name="{x:Bind Name}" ToolTipService.ToolTip="{x:Bind Name}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <FontIcon Glyph="{x:Bind Glyph}" FontSize="17" HorizontalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </Grid>
    </DataTemplate>
    <DataTemplate x:Key="LibrarySourceCompactTemplate" x:DataType="local:LibrarySourceItem">
      <Grid Width="48" Height="{StaticResource LibraryNavigationItemHeight}" AutomationProperties.Name="{x:Bind Name}" ToolTipService.ToolTip="{x:Bind Name}">
        <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>
    <Style x:Key="LibrarySourceItemStyle" TargetType="ListViewItem">
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="MinHeight" Value="{StaticResource LibraryNavigationItemHeight}" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="{StaticResource LibraryNavigationItemMargin}" />
      <Setter Property="CornerRadius" Value="{StaticResource LibraryNavigationItemRadius}" />
    </Style>
    <DataTemplate x:Key="LibraryGenericTemplate" x:DataType="local:LibraryRow">
      <Grid ColumnSpacing="12" Padding="2,7" AutomationProperties.Name="{x:Bind Name}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{x:Bind Detail}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind DetailVisibility}" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{x:Bind Extra}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </Grid>
    </DataTemplate>
    <!-- Each medium gets the density and visual hierarchy that suits it, while all four panels
         remain virtualised ListView panels with the same keyboard and screen-reader behaviour. -->
    <ItemsPanelTemplate x:Key="LibraryListPanel"><ItemsStackPanel Orientation="Vertical" /></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="LibraryBrowsePanel"><ItemsWrapGrid Orientation="Horizontal" ItemWidth="196" ItemHeight="246" /></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="LibraryVideoPanel"><ItemsWrapGrid Orientation="Horizontal" ItemWidth="270" ItemHeight="218" /></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="LibraryPhotoPanel"><ItemsWrapGrid Orientation="Horizontal" ItemWidth="226" ItemHeight="220" /></ItemsPanelTemplate>
</ResourceDictionary>

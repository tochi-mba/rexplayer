<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Rex.Media.App</RootNamespace>
    <AssemblyName>rexplayer</AssemblyName>
    <AssemblyTitle>rexplayer</AssemblyTitle>
    <ApplicationIcon>..\..\assets\rexplayer.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <UseWinUI>true</UseWinUI>
    <!-- Unpackaged and carrying its own Windows App SDK, so the per-user installer needs no
         prerequisites and no administrator (ADR-017). -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <Platforms>x64</Platforms>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Rex.Media.Primitives\Rex.Media.Primitives.csproj" />
    <ProjectReference Include="..\Rex.Media.Diagnostics\Rex.Media.Diagnostics.csproj" />
    <ProjectReference Include="..\Rex.Media.IO\Rex.Media.IO.csproj" />
    <ProjectReference Include="..\Rex.Media.Audio\Rex.Media.Audio.csproj" />
    <ProjectReference Include="..\Rex.Media.Audio.Wasapi\Rex.Media.Audio.Wasapi.csproj" />
    <ProjectReference Include="..\Rex.Media.Codecs.MediaFoundation\Rex.Media.Codecs.MediaFoundation.csproj" />
    <ProjectReference Include="..\Rex.Media.Engine\Rex.Media.Engine.csproj" />
    <ProjectReference Include="..\Rex.Media.Settings\Rex.Media.Settings.csproj" />
    <ProjectReference Include="..\Rex.Media.Video\Rex.Media.Video.csproj" />
    <ProjectReference Include="..\Rex.Media.Video.D3D11\Rex.Media.Video.D3D11.csproj" />
    <ProjectReference Include="..\Rex.Media.Interop\Rex.Media.Interop.csproj" />
    <ProjectReference Include="..\Rex.Media.AppCore\Rex.Media.AppCore.csproj" />
  </ItemGroup>
  <!-- Publishing an unpackaged WinUI app leaves out the app's resource index and compiled XAML,
       without which the window cannot start (0xC000027B). Copy them from the build output. -->
  <Target Name="PublishXamlResources" AfterTargets="Publish">
    <ItemGroup>
      <XamlResource Include="$(OutDir)$(AssemblyName).pri;$(OutDir)*.xbf" />
    </ItemGroup>
    <Copy SourceFiles="@(XamlResource)" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

</Project>

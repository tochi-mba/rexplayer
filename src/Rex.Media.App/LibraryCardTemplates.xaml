<?xml version="1.0" encoding="utf-8"?>
<!-- The library's card layouts: Cards, Big cards (wide video frames), posters, Collage and the
     picture gallery. Each card shows its play mark when pointed at, and the window keeps the
     handlers; this dictionary is created the first time the library lays out a view, not at launch. -->
<ResourceDictionary
    x:Class="Rex.Media.App.LibraryCardTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Rex.Media.App">
  <DataTemplate x:Key="LibraryBrowseTemplate" x:DataType="local:LibraryRow">
    <Grid Padding="6" RowSpacing="8" AutomationProperties.Name="{x:Bind Name}" PointerEntered="OnCardPointerEntered" PointerExited="OnCardPointerExited" GettingFocus="OnCardGettingFocus">
      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Border CornerRadius="10" Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid>
          <TextBlock Text="{x:Bind PicturePlaceholder}" FontSize="48" Opacity="0.3" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Image Source="{x:Bind Picture, Mode=OneWay}" Stretch="Uniform" Opacity="{x:Bind PictureOpacity, Mode=OneWay}">
            <Image.OpacityTransition><ScalarTransition Duration="0:0:0.2" /></Image.OpacityTransition>
          </Image>
          <Border x:Name="CardPlay" Opacity="0" Width="44" Height="44" CornerRadius="22" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Background="{ThemeResource AccentFillColorDefaultBrush}" IsHitTestVisible="False">
            <FontIcon Glyph="&#xE768;" FontSize="18" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
          </Border>
          <Border Visibility="{x:Bind PlayingVisibility, Mode=OneWay}" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="9" Padding="8,3" Margin="9" HorizontalAlignment="Left" VerticalAlignment="Top">
            <TextBlock Text="NOW PLAYING" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
          </Border>
        </Grid>
      </Border>
      <StackPanel Grid.Row="1">
        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
        <TextBlock Text="{x:Bind Detail}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind DetailVisibility}" />
        <TextBlock Text="{x:Bind Extra}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
      </StackPanel>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="LibraryVideoTemplate" x:DataType="local:LibraryRow">
    <Grid Padding="6" RowSpacing="8" AutomationProperties.Name="{x:Bind Name}" AutomationProperties.HelpText="{x:Bind TranscriptText, Mode=OneWay}" PointerEntered="OnCardPointerEntered" PointerExited="OnCardPointerExited" GettingFocus="OnCardGettingFocus">
      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Border CornerRadius="10" Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid>
          <TextBlock Text="{x:Bind PicturePlaceholder}" FontSize="42" Opacity="0.3" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Image Source="{x:Bind Picture, Mode=OneWay}" Stretch="UniformToFill" />
          <Border Visibility="{x:Bind BadgeVisibility}" Background="#C0181818" CornerRadius="4" Padding="6,2" Margin="7" HorizontalAlignment="Left" VerticalAlignment="Bottom">
            <TextBlock Text="{x:Bind Badge}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
          </Border>
          <Border Background="#C0181818" CornerRadius="4" Padding="6,2" Margin="7" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <TextBlock Text="{x:Bind Extra}" Foreground="White" FontSize="12" FontFamily="Cascadia Mono, Consolas" />
          </Border>
          <ProgressBar Value="{x:Bind Progress}" Maximum="1" Visibility="{x:Bind ProgressVisibility}" VerticalAlignment="Bottom" Margin="0" />
          <Border Visibility="{x:Bind TranscriptVisibility, Mode=OneWay}" Background="#C0181818" CornerRadius="4" Padding="5,3" Margin="7"
                  HorizontalAlignment="Right" VerticalAlignment="Top" ToolTipService.ToolTip="{x:Bind TranscriptText, Mode=OneWay}"
                  AutomationProperties.AutomationId="LibraryTranscriptBadge" AutomationProperties.Name="{x:Bind TranscriptText, Mode=OneWay}">
            <FontIcon Glyph="{x:Bind TranscriptGlyph, Mode=OneWay}" FontSize="13" Foreground="White" />
          </Border>
          <Border x:Name="CardPlay" Opacity="0" Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Background="{ThemeResource AccentFillColorDefaultBrush}" IsHitTestVisible="False">
            <FontIcon Glyph="&#xE768;" FontSize="20" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
          </Border>
          <Border Visibility="{x:Bind PlayingVisibility, Mode=OneWay}" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="9" Padding="8,3" Margin="7" HorizontalAlignment="Left" VerticalAlignment="Top">
            <TextBlock Text="NOW PLAYING" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
          </Border>
        </Grid>
      </Border>
      <StackPanel Grid.Row="1">
        <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
        <TextBlock Text="{x:Bind Detail}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind DetailVisibility}" FontSize="12" />
      </StackPanel>
    </Grid>
  </DataTemplate>
  <!-- Poster-height cards keep their image ratio. Hover or focus reveals Play but never hides the artwork. -->
  <DataTemplate x:Key="LibraryMovieTemplate" x:DataType="local:LibraryRow">
    <Grid Padding="7" RowSpacing="8" AutomationProperties.Name="{x:Bind Name}" AutomationProperties.HelpText="{x:Bind TranscriptText, Mode=OneWay}" PointerEntered="OnCardPointerEntered" PointerExited="OnCardPointerExited" GettingFocus="OnCardGettingFocus">
      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Border CornerRadius="12" Background="#20252D" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
        <Grid>
          <TextBlock Text="{x:Bind PicturePlaceholder}" FontSize="54" Opacity="0.36" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Image Source="{x:Bind Picture, Mode=OneWay}" Stretch="Uniform" />
          <Border Background="#BE17202C" CornerRadius="4" Padding="6,3" Margin="9" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Visibility="{x:Bind BadgeVisibility}">
            <TextBlock Text="{x:Bind Badge}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
          </Border>
          <Border Visibility="{x:Bind TranscriptVisibility, Mode=OneWay}" Background="#C0181818" CornerRadius="4" Padding="5,3" Margin="9"
                  HorizontalAlignment="Right" VerticalAlignment="Top" ToolTipService.ToolTip="{x:Bind TranscriptText, Mode=OneWay}"
                  AutomationProperties.AutomationId="LibraryTranscriptBadge" AutomationProperties.Name="{x:Bind TranscriptText, Mode=OneWay}">
            <FontIcon Glyph="{x:Bind TranscriptGlyph, Mode=OneWay}" FontSize="13" Foreground="White" />
          </Border>
          <Border x:Name="CardPlay" Opacity="0" Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Background="{ThemeResource AccentFillColorDefaultBrush}" IsHitTestVisible="False">
            <FontIcon Glyph="&#xE768;" FontSize="22" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
          </Border>
          <Border Visibility="{x:Bind PlayingVisibility, Mode=OneWay}" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="9" Padding="8,3" Margin="9" HorizontalAlignment="Left" VerticalAlignment="Top">
            <TextBlock Text="NOW PLAYING" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
          </Border>
        </Grid>
      </Border>
      <StackPanel Grid.Row="1" Spacing="2">
        <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{x:Bind Detail}" Visibility="{x:Bind DetailVisibility}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" FontSize="12" />
      </StackPanel>
    </Grid>
  </DataTemplate>
  <!-- Justified collage: variable-width items, virtualized by ItemsView and LinedFlowLayout. -->
  <DataTemplate x:Key="LibraryCollageTemplate" x:DataType="local:LibraryRow">
    <ItemContainer AutomationProperties.Name="{x:Bind Name}" Loaded="OnCollageItemLoaded" DataContextChanged="OnCollageItemDataChanged">
      <Grid Margin="2" PointerEntered="OnCardPointerEntered" PointerExited="OnCardPointerExited" GettingFocus="OnCardGettingFocus">
        <Border CornerRadius="9" Background="#20252D">
          <Grid>
            <TextBlock Text="{x:Bind PicturePlaceholder}" FontSize="44" Opacity="0.3" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Image Source="{x:Bind Picture, Mode=OneWay}" Stretch="UniformToFill" />
            <Border VerticalAlignment="Bottom">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#00000000" Offset="0" />
                  <GradientStop Color="#E5151A22" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <StackPanel Padding="12,28,12,11" Spacing="2">
                <TextBlock Text="{x:Bind Name}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" />
                <TextBlock Text="{x:Bind Detail}" Foreground="#DCE3ED" Visibility="{x:Bind DetailVisibility}" TextTrimming="CharacterEllipsis" MaxLines="1" FontSize="12" />
              </StackPanel>
            </Border>
            <Border x:Name="CardPlay" Opacity="0" Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}" IsHitTestVisible="False">
              <FontIcon Glyph="&#xE768;" FontSize="20" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
            <ProgressBar Value="{x:Bind Progress}" Maximum="1" Visibility="{x:Bind ProgressVisibility}" VerticalAlignment="Bottom" />
            <Border Visibility="{x:Bind PlayingVisibility, Mode=OneWay}" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="9" Padding="8,3" Margin="9" HorizontalAlignment="Left" VerticalAlignment="Top">
              <TextBlock Text="NOW PLAYING" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
          </Grid>
        </Border>
      </Grid>
    </ItemContainer>
  </DataTemplate>
  <DataTemplate x:Key="LibraryPhotoTemplate" x:DataType="local:LibraryRow">
    <Grid Padding="4" AutomationProperties.Name="{x:Bind Name}" PointerEntered="OnCardPointerEntered" PointerExited="OnCardPointerExited" GettingFocus="OnCardGettingFocus">
      <Border CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid>
          <TextBlock Text="{x:Bind PicturePlaceholder}" FontSize="42" Opacity="0.3" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Image Source="{x:Bind Picture, Mode=OneWay}" Stretch="UniformToFill" />
          <Border x:Name="CardPlay" Opacity="0" VerticalAlignment="Bottom" Padding="10,6" IsHitTestVisible="False">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#00000000" Offset="0" />
                <GradientStop Color="#C0000000" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="{x:Bind Name}" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis" />
          </Border>
          <Border Visibility="{x:Bind PlayingVisibility, Mode=OneWay}" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="9" Padding="8,3" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top">
            <TextBlock Text="NOW PLAYING" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
          </Border>
        </Grid>
      </Border>
    </Grid>
  </DataTemplate>
</ResourceDictionary>

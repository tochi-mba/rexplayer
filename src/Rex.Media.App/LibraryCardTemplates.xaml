<?xml version="1.0" encoding="utf-8"?>
<!-- The library's card layouts: Cards, Big cards (wide video frames), posters, Collage and the
     picture gallery. Each card shows its play mark when pointed at, and the window keeps the
     handlers; this dictionary is created the first time the library lays out a view, not at launch. -->
<ResourceDictionary
    x:Class="Rex.Media.App.LibraryCardTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Rex.Media.App">
  <DataTemplate x:Key="LibraryBrowseTemplate" x:DataType="local:LibraryRow">
    <Grid Padding="6" RowSpacing="8" AutomationProperties.Name="{x:Bind AccessibilityName, Mode=OneWay}" AutomationProperties.HelpText="{x:Bind AccessibilityDetails, Mode=OneWay}" PointerEntered="OnCardPointerEntered" PointerExited="OnCardPointerExited" GettingFocus="OnCardGettingFocus" LosingFocus="OnCardLosingFocus">
      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Border CornerRadius="10" Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid>
          <FontIcon Glyph="{x:Bind PlaceholderGlyph}" FontSize="38" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Image Source="{x:Bind Picture, Mode=OneWay}" Stretch="UniformToFill" Opacity="{x:Bind PictureOpacity, Mode=OneWay}">
            <Image.OpacityTransition><ScalarTransition Duration="0:0:0.2" /></Image.OpacityTransition>
          </Image>
          <ProgressBar Value="{x:Bind Progress}" Maximum="1" Visibility="{x:Bind ProgressVisibility}" VerticalAlignment="Bottom" />
          <Border x:Name="CardPlay" Opacity="0" Width="44" Height="44" CornerRadius="22" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Background="{ThemeResource AccentFillColorDefaultBrush}" IsHitTestVisible="False">
            <FontIcon Glyph="&#xE768;" FontSize="18" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
          </Border>
          <Border Visibility="{x:Bind PlayingVisibility, Mode=OneWay}" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="9" Padding="8,3" Margin="9" HorizontalAlignment="Left" VerticalAlignment="Top">
            <TextBlock Text="NOW PLAYING" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
          </Border>
          <ProgressRing Visibility="{x:Bind DownloadVisibility, Mode=OneWay}" Value="{x:Bind DownloadPercent, Mode=OneWay}" IsIndeterminate="False" Maximum="100" Width="26" Height="26" Margin="9"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{StaticResource RexOverlayTextBrush}" Background="{StaticResource RexOverlayBrush}" IsHitTestVisible="False"
                        ToolTipService.ToolTip="{x:Bind DownloadText, Mode=OneWay}" AutomationProperties.AutomationId="LibraryDownloadBadge" AutomationProperties.Name="{x:Bind DownloadText, Mode=OneWay}" />
          <FontIcon Glyph="&#xE896;" Visibility="{x:Bind DownloadVisibility, Mode=OneWay}" FontSize="10" Foreground="{StaticResource RexOverlayTextBrush}" Width="26" Height="26" Margin="9" HorizontalAlignment="Right" VerticalAlignment="Top" />
        </Grid>
      </Border>
      <StackPanel Grid.Row="1">
        <TextBlock Text="{x:Bind Name}" FlowDirection="{x:Bind NameDirection}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
        <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind DetailVisibility, Mode=OneWay}" />
        <TextBlock Text="{x:Bind Extra}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
      </StackPanel>
    </Grid>
  </DataTemplate>
  <DataTemplate x:Key="LibraryVideoTemplate" x:DataType="local:LibraryRow">
    <Grid Padding="6" RowSpacing="8" AutomationProperties.Name="{x:Bind AccessibilityName, Mode=OneWay}" AutomationProperties.HelpText="{x:Bind TranscriptText, Mode=OneWay}" PointerEntered="OnCardPointerEntered" PointerExited="OnCardPointerExited" GettingFocus="OnCardGettingFocus" LosingFocus="OnCardLosingFocus">
      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Border CornerRadius="10" Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid>
          <FontIcon Glyph="{x:Bind PlaceholderGlyph}" FontSize="34" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Image Source="{x:Bind Picture, Mode=OneWay}" Stretch="UniformToFill" Opacity="{x:Bind PictureOpacity, Mode=OneWay}">
            <Image.OpacityTransition><ScalarTransition Duration="0:0:0.2" /></Image.OpacityTransition>
          </Image>
          <Border Visibility="{x:Bind BadgeVisibility}" Background="{StaticResource RexOverlayBrush}" CornerRadius="4" Padding="6,2" Margin="7" HorizontalAlignment="Left" VerticalAlignment="Bottom">
            <TextBlock Text="{x:Bind Badge}" Foreground="{StaticResource RexOverlayTextBrush}" FontSize="12" FontWeight="SemiBold" />
          </Border>
          <Border Background="{StaticResource RexOverlayBrush}" CornerRadius="4" Padding="6,2" Margin="7" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <TextBlock Text="{x:Bind Extra}" Foreground="{StaticResource RexOverlayTextBrush}" FontSize="12" FontFamily="{StaticResource RexMonoFontFamily}" />
          </Border>
          <ProgressBar Value="{x:Bind Progress}" Maximum="1" Visibility="{x:Bind ProgressVisibility}" VerticalAlignment="Bottom" Margin="0" />
          <Border Visibility="{x:Bind TranscriptVisibility, Mode=OneWay}" Background="{StaticResource RexOverlayBrush}" CornerRadius="4" Padding="5,3" Margin="7"
                  HorizontalAlignment="Right" VerticalAlignment="Top" ToolTipService.ToolTip="{x:Bind TranscriptText, Mode=OneWay}"
                  AutomationProperties.AutomationId="LibraryTranscriptBadge" AutomationProperties.Name="{x:Bind TranscriptText, Mode=OneWay}">
            <FontIcon Glyph="{x:Bind TranscriptGlyph, Mode=OneWay}" FontSize="13" Foreground="{StaticResource RexOverlayTextBrush}" />
          </Border>
          <Border x:Name="CardPlay" Opacity="0" Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Background="{ThemeResource AccentFillColorDefaultBrush}" IsHitTestVisible="False">
            <FontIcon Glyph="&#xE768;" FontSize="20" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
          </Border>
          <Border Visibility="{x:Bind PlayingVisibility, Mode=OneWay}" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="9" Padding="8,3" Margin="7" HorizontalAlignment="Left" VerticalAlignment="Top">
            <TextBlock Text="NOW PLAYING" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
          </Border>
          <ProgressRing Visibility="{x:Bind DownloadVisibility, Mode=OneWay}" Value="{x:Bind DownloadPercent, Mode=OneWay}" IsIndeterminate="False" Maximum="100" Width="26" Height="26" Margin="7,7,38,7"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{StaticResource RexOverlayTextBrush}" Background="{StaticResource RexOverlayBrush}" IsHitTestVisible="False"
                        ToolTipService.ToolTip="{x:Bind DownloadText, Mode=OneWay}" AutomationProperties.AutomationId="LibraryDownloadBadge" AutomationProperties.Name="{x:Bind DownloadText, Mode=OneWay}" />
          <FontIcon Glyph="&#xE896;" Visibility="{x:Bind DownloadVisibility, Mode=OneWay}" FontSize="10" Foreground="{StaticResource RexOverlayTextBrush}" Width="26" Height="26" Margin="7,7,38,7" HorizontalAlignment="Right" VerticalAlignment="Top" />
        </Grid>
      </Border>
      <StackPanel Grid.Row="1">
        <TextBlock Text="{x:Bind Name}" FlowDirection="{x:Bind NameDirection}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
        <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind DetailVisibility, Mode=OneWay}" FontSize="12" />
      </StackPanel>
    </Grid>
  </DataTemplate>
  <!-- Poster-height cards: the artwork fills the frame, cropped from the top so faces stay. Hover or focus reveals Play but never hides the artwork. -->
  <DataTemplate x:Key="LibraryMovieTemplate" x:DataType="local:LibraryRow">
    <Grid Padding="7" RowSpacing="8" AutomationProperties.Name="{x:Bind AccessibilityName, Mode=OneWay}" AutomationProperties.HelpText="{x:Bind TranscriptText, Mode=OneWay}" PointerEntered="OnCardPointerEntered" PointerExited="OnCardPointerExited" GettingFocus="OnCardGettingFocus" LosingFocus="OnCardLosingFocus">
      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Border CornerRadius="12" Background="{x:Bind TileBackground, Mode=OneWay}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
        <Grid>
          <FontIcon Glyph="{x:Bind PlaceholderGlyph}" FontSize="43" Foreground="{StaticResource RexOverlaySecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Image Source="{x:Bind Picture, Mode=OneWay}" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="{x:Bind PictureOpacity, Mode=OneWay}">
            <Image.OpacityTransition><ScalarTransition Duration="0:0:0.2" /></Image.OpacityTransition>
          </Image>
          <Border Background="{StaticResource RexOverlayBrush}" CornerRadius="4" Padding="6,3" Margin="9" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Visibility="{x:Bind BadgeVisibility}">
            <TextBlock Text="{x:Bind Badge}" Foreground="{StaticResource RexOverlayTextBrush}" FontSize="12" FontWeight="SemiBold" />
          </Border>
          <Border Visibility="{x:Bind TranscriptVisibility, Mode=OneWay}" Background="{StaticResource RexOverlayBrush}" CornerRadius="4" Padding="5,3" Margin="9"
                  HorizontalAlignment="Right" VerticalAlignment="Top" ToolTipService.ToolTip="{x:Bind TranscriptText, Mode=OneWay}"
                  AutomationProperties.AutomationId="LibraryTranscriptBadge" AutomationProperties.Name="{x:Bind TranscriptText, Mode=OneWay}">
            <FontIcon Glyph="{x:Bind TranscriptGlyph, Mode=OneWay}" FontSize="13" Foreground="{StaticResource RexOverlayTextBrush}" />
          </Border>
          <Border x:Name="CardPlay" Opacity="0" Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                  Background="{ThemeResource AccentFillColorDefaultBrush}" IsHitTestVisible="False">
            <FontIcon Glyph="&#xE768;" FontSize="22" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
          </Border>
          <Border Visibility="{x:Bind PlayingVisibility, Mode=OneWay}" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="9" Padding="8,3" Margin="9" HorizontalAlignment="Left" VerticalAlignment="Top">
            <TextBlock Text="NOW PLAYING" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
          </Border>
          <!-- A movie's details page, one click away from its card. -->
          <Button Visibility="{x:Bind InfoVisibility}" Click="OnCardInfoClick" Width="32" Height="32" Padding="0" CornerRadius="16" Margin="9"
                  HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="{StaticResource RexOverlayBrush}" BorderThickness="0"
                  ToolTipService.ToolTip="Details" AutomationProperties.Name="Details" AutomationProperties.AutomationId="LibraryCardInfo">
            <FontIcon Glyph="&#xE946;" FontSize="14" Foreground="{StaticResource RexOverlayTextBrush}" />
          </Button>
          <ProgressRing Visibility="{x:Bind DownloadVisibility, Mode=OneWay}" Value="{x:Bind DownloadPercent, Mode=OneWay}" IsIndeterminate="False" Maximum="100" Width="26" Height="26" Margin="9,9,40,9"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{StaticResource RexOverlayTextBrush}" Background="{StaticResource RexOverlayBrush}" IsHitTestVisible="False"
                        ToolTipService.ToolTip="{x:Bind DownloadText, Mode=OneWay}" AutomationProperties.AutomationId="LibraryDownloadBadge" AutomationProperties.Name="{x:Bind DownloadText, Mode=OneWay}" />
          <FontIcon Glyph="&#xE896;" Visibility="{x:Bind DownloadVisibility, Mode=OneWay}" FontSize="10" Foreground="{StaticResource RexOverlayTextBrush}" Width="26" Height="26" Margin="9,9,40,9" HorizontalAlignment="Right" VerticalAlignment="Top" />
        </Grid>
      </Border>
      <StackPanel Grid.Row="1" Spacing="2">
        <TextBlock Text="{x:Bind Name}" FlowDirection="{x:Bind NameDirection}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Visibility="{x:Bind DetailVisibility, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" FontSize="12" />
      </StackPanel>
    </Grid>
  </DataTemplate>
  <!-- Justified collage: variable-width items, virtualized by ItemsView and LinedFlowLayout. -->
  <DataTemplate x:Key="LibraryCollageTemplate" x:DataType="local:LibraryRow">
    <!-- An items view sets no data context for a compiled template, so the tile binds its row as one:
         loading, hover and taps find the row through it. -->
    <ItemContainer DataContext="{x:Bind Self}" AutomationProperties.Name="{x:Bind AccessibilityName, Mode=OneWay}" AutomationProperties.HelpText="{x:Bind AccessibilityDetails, Mode=OneWay}" Loaded="OnCollageItemLoaded" DataContextChanged="OnCollageItemDataChanged">
      <Grid Margin="2" PointerEntered="OnCardPointerEntered" PointerExited="OnCardPointerExited" GettingFocus="OnCardGettingFocus" LosingFocus="OnCardLosingFocus">
        <Border CornerRadius="9" Background="{x:Bind TileBackground, Mode=OneWay}">
          <Grid>
            <Image Source="{x:Bind Backdrop, Mode=OneWay}" Stretch="UniformToFill" Opacity="0.45" />
            <FontIcon Glyph="{x:Bind PlaceholderGlyph}" FontSize="35" Foreground="{StaticResource RexOverlaySecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Image Source="{x:Bind Picture, Mode=OneWay}" Stretch="UniformToFill" Opacity="{x:Bind PictureOpacity, Mode=OneWay}">
              <Image.OpacityTransition><ScalarTransition Duration="0:0:0.2" /></Image.OpacityTransition>
            </Image>
            <!-- A scrim under the words keeps them readable over any picture. -->
            <Border VerticalAlignment="Bottom">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="{StaticResource RexScrimClearColor}" Offset="0" />
                  <GradientStop Color="{StaticResource RexScrimColor}" Offset="0.45" />
                  <GradientStop Color="{StaticResource RexScrimStrongColor}" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <StackPanel Padding="12,36,12,11" Spacing="2">
                <TextBlock Text="{x:Bind Name}" FlowDirection="{x:Bind NameDirection}" Foreground="{StaticResource RexOverlayTextBrush}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxLines="1" />
                <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Foreground="{StaticResource RexOverlaySecondaryTextBrush}" Visibility="{x:Bind DetailVisibility, Mode=OneWay}" TextTrimming="CharacterEllipsis" MaxLines="1" FontSize="12" />
              </StackPanel>
            </Border>
            <ProgressRing Visibility="{x:Bind DownloadVisibility, Mode=OneWay}" Value="{x:Bind DownloadPercent, Mode=OneWay}" IsIndeterminate="False" Maximum="100" Width="26" Height="26" Margin="9"
                          HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{StaticResource RexOverlayTextBrush}" Background="{StaticResource RexOverlayBrush}" IsHitTestVisible="False"
                          ToolTipService.ToolTip="{x:Bind DownloadText, Mode=OneWay}" AutomationProperties.AutomationId="LibraryDownloadBadge" AutomationProperties.Name="{x:Bind DownloadText, Mode=OneWay}" />
            <FontIcon Glyph="&#xE896;" Visibility="{x:Bind DownloadVisibility, Mode=OneWay}" FontSize="10" Foreground="{StaticResource RexOverlayTextBrush}" Width="26" Height="26" Margin="9" HorizontalAlignment="Right" VerticalAlignment="Top" />
            <Border x:Name="CardPlay" Opacity="0" Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}" IsHitTestVisible="False">
              <FontIcon Glyph="&#xE768;" FontSize="20" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
            <ProgressBar Value="{x:Bind Progress}" Maximum="1" Visibility="{x:Bind ProgressVisibility}" VerticalAlignment="Bottom" />
            <Border Visibility="{x:Bind PlayingVisibility, Mode=OneWay}" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="9" Padding="8,3" Margin="9" HorizontalAlignment="Left" VerticalAlignment="Top">
              <TextBlock Text="NOW PLAYING" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
          </Grid>
        </Border>
      </Grid>
    </ItemContainer>
  </DataTemplate>
  <DataTemplate x:Key="LibraryPhotoTemplate" x:DataType="local:LibraryRow">
    <Grid Padding="4" RowSpacing="5" AutomationProperties.Name="{x:Bind AccessibilityName, Mode=OneWay}" AutomationProperties.HelpText="{x:Bind Detail, Mode=OneWay}" PointerEntered="OnCardPointerEntered" PointerExited="OnCardPointerExited" GettingFocus="OnCardGettingFocus" LosingFocus="OnCardLosingFocus">
      <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
        <Grid>
          <FontIcon Glyph="{x:Bind PlaceholderGlyph}" FontSize="34" Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Image Source="{x:Bind Picture, Mode=OneWay}" Stretch="Uniform" />
          <Border x:Name="CardPlay" Opacity="0" VerticalAlignment="Bottom" Padding="10,6" IsHitTestVisible="False">
            <Border.Background>
              <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource RexScrimClearColor}" Offset="0" />
                <GradientStop Color="{StaticResource RexScrimStrongColor}" Offset="1" />
              </LinearGradientBrush>
            </Border.Background>
            <TextBlock Text="Open picture" Foreground="{StaticResource RexOverlayTextBrush}" FontSize="12" />
          </Border>
          <ProgressRing Visibility="{x:Bind DownloadVisibility, Mode=OneWay}" Value="{x:Bind DownloadPercent, Mode=OneWay}" IsIndeterminate="False" Maximum="100" Width="26" Height="26" Margin="8"
                        HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="{StaticResource RexOverlayTextBrush}" Background="{StaticResource RexOverlayBrush}" IsHitTestVisible="False"
                        ToolTipService.ToolTip="{x:Bind DownloadText, Mode=OneWay}" AutomationProperties.AutomationId="LibraryDownloadBadge" AutomationProperties.Name="{x:Bind DownloadText, Mode=OneWay}" />
          <FontIcon Glyph="&#xE896;" Visibility="{x:Bind DownloadVisibility, Mode=OneWay}" FontSize="10" Foreground="{StaticResource RexOverlayTextBrush}" Width="26" Height="26" Margin="8" HorizontalAlignment="Right" VerticalAlignment="Top" />
          <Border Visibility="{x:Bind PlayingVisibility, Mode=OneWay}" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="9" Padding="8,3" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top">
            <TextBlock Text="NOW PLAYING" FontSize="10" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
          </Border>
        </Grid>
      </Border>
      <StackPanel Grid.Row="1" Spacing="2" Margin="4,0,4,0">
        <TextBlock Text="{x:Bind Name}" FlowDirection="{x:Bind NameDirection}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FontSize="12" />
        <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Visibility="{x:Bind DetailVisibility, Mode=OneWay}" TextTrimming="CharacterEllipsis" FontSize="11" />
      </StackPanel>
    </Grid>
  </DataTemplate>
</ResourceDictionary>

<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Rex.Media.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Rex.Media.App">

  <Grid x:Name="Root" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
  <Grid.Resources>
    <!-- Each medium gets the density and visual hierarchy that suits it, while all four panels
         remain virtualised ListView panels with the same keyboard and screen-reader behaviour. -->
    <ItemsPanelTemplate x:Key="LibraryListPanel"><ItemsStackPanel Orientation="Vertical" /></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="LibraryBrowsePanel"><ItemsWrapGrid Orientation="Horizontal" ItemWidth="196" ItemHeight="246" /></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="LibraryVideoPanel"><ItemsWrapGrid Orientation="Horizontal" ItemWidth="270" ItemHeight="218" /></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="LibraryPhotoPanel"><ItemsWrapGrid Orientation="Horizontal" ItemWidth="226" ItemHeight="220" /></ItemsPanelTemplate>

    <DataTemplate x:Key="LibrarySongTemplate" x:DataType="local:LibraryRow">
      <Grid ColumnSpacing="12" Padding="2,5" MinHeight="64" AutomationProperties.Name="{x:Bind Name}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="32" />
          <ColumnDefinition Width="54" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{x:Bind Badge}" Visibility="{x:Bind BadgeVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Cascadia Mono, Consolas" />
        <Border Grid.Column="1" Width="54" Height="54" CornerRadius="5" Background="{ThemeResource LayerFillColorDefaultBrush}">
          <Grid>
            <TextBlock Text="{x:Bind PicturePlaceholder}" FontSize="22" Opacity="0.38" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Image Source="{x:Bind Picture, Mode=OneWay}" Stretch="UniformToFill" />
          </Grid>
        </Border>
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
          <TextBlock Text="{x:Bind Detail}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind DetailVisibility}" />
        </StackPanel>
        <TextBlock Grid.Column="3" Text="{x:Bind Extra}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Cascadia Mono, Consolas" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="LibraryBrowseTemplate" x:DataType="local:LibraryRow">
      <Grid Padding="6" RowSpacing="8" AutomationProperties.Name="{x:Bind Name}" PointerEntered="OnCardPointerEntered" PointerExited="OnCardPointerExited" GettingFocus="OnCardGettingFocus">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border CornerRadius="10" Background="{ThemeResource LayerFillColorDefaultBrush}">
          <Grid>
            <TextBlock Text="{x:Bind PicturePlaceholder}" FontSize="48" Opacity="0.3" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Image Source="{x:Bind Picture, Mode=OneWay}" Stretch="Uniform" />
            <Border x:Name="CardPlay" Opacity="0" Width="44" Height="44" CornerRadius="22" Margin="10" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Background="{ThemeResource AccentFillColorDefaultBrush}" IsHitTestVisible="False">
              <FontIcon Glyph="&#xE768;" FontSize="18" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
          </Grid>
        </Border>
        <StackPanel Grid.Row="1">
          <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
          <TextBlock Text="{x:Bind Detail}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind DetailVisibility}" />
          <TextBlock Text="{x:Bind Extra}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="LibraryVideoTemplate" x:DataType="local:LibraryRow">
      <Grid Padding="6" RowSpacing="8" AutomationProperties.Name="{x:Bind Name}" PointerEntered="OnCardPointerEntered" PointerExited="OnCardPointerExited" GettingFocus="OnCardGettingFocus">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border CornerRadius="10" Background="{ThemeResource LayerFillColorDefaultBrush}">
          <Grid>
            <TextBlock Text="{x:Bind PicturePlaceholder}" FontSize="42" Opacity="0.3" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Image Source="{x:Bind Picture, Mode=OneWay}" Stretch="UniformToFill" />
            <Border Visibility="{x:Bind BadgeVisibility}" Background="#C0181818" CornerRadius="4" Padding="6,2" Margin="7" HorizontalAlignment="Left" VerticalAlignment="Bottom">
              <TextBlock Text="{x:Bind Badge}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
            </Border>
            <Border Background="#C0181818" CornerRadius="4" Padding="6,2" Margin="7" HorizontalAlignment="Right" VerticalAlignment="Bottom">
              <TextBlock Text="{x:Bind Extra}" Foreground="White" FontSize="12" FontFamily="Cascadia Mono, Consolas" />
            </Border>
            <ProgressBar Value="{x:Bind Progress}" Maximum="1" Visibility="{x:Bind ProgressVisibility}" VerticalAlignment="Bottom" Margin="0" />
            <Border x:Name="CardPlay" Opacity="0" Width="48" Height="48" CornerRadius="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}" IsHitTestVisible="False">
              <FontIcon Glyph="&#xE768;" FontSize="20" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
          </Grid>
        </Border>
        <StackPanel Grid.Row="1">
          <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
          <TextBlock Text="{x:Bind Detail}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind DetailVisibility}" FontSize="12" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <!-- Poster-height cards keep their image ratio. Hover or focus reveals Play but never hides the artwork. -->
    <DataTemplate x:Key="LibraryMovieTemplate" x:DataType="local:LibraryRow">
      <Grid Padding="7" RowSpacing="8" AutomationProperties.Name="{x:Bind Name}" PointerEntered="OnCardPointerEntered" PointerExited="OnCardPointerExited" GettingFocus="OnCardGettingFocus">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Border CornerRadius="12" Background="#20252D" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="1">
          <Grid>
            <TextBlock Text="{x:Bind PicturePlaceholder}" FontSize="54" Opacity="0.36" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Image Source="{x:Bind Picture, Mode=OneWay}" Stretch="Uniform" />
            <Border Background="#BE17202C" CornerRadius="4" Padding="6,3" Margin="9" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Visibility="{x:Bind BadgeVisibility}">
              <TextBlock Text="{x:Bind Badge}" Foreground="White" FontSize="12" FontWeight="SemiBold" />
            </Border>
            <Border x:Name="CardPlay" Opacity="0" Width="56" Height="56" CornerRadius="28" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{ThemeResource AccentFillColorDefaultBrush}" IsHitTestVisible="False">
              <FontIcon Glyph="&#xE768;" FontSize="22" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
            </Border>
          </Grid>
        </Border>
        <StackPanel Grid.Row="1" Spacing="2">
          <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{x:Bind Detail}" Visibility="{x:Bind DetailVisibility}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" FontSize="12" />
        </StackPanel>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="LibraryPhotoTemplate" x:DataType="local:LibraryRow">
      <Grid Padding="4" AutomationProperties.Name="{x:Bind Name}" PointerEntered="OnCardPointerEntered" PointerExited="OnCardPointerExited" GettingFocus="OnCardGettingFocus">
        <Border CornerRadius="8" Background="{ThemeResource LayerFillColorDefaultBrush}">
          <Grid>
            <TextBlock Text="{x:Bind PicturePlaceholder}" FontSize="42" Opacity="0.3" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Image Source="{x:Bind Picture, Mode=OneWay}" Stretch="UniformToFill" />
            <Border x:Name="CardPlay" Opacity="0" VerticalAlignment="Bottom" Padding="10,6" IsHitTestVisible="False">
              <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#00000000" Offset="0" />
                  <GradientStop Color="#C0000000" Offset="1" />
                </LinearGradientBrush>
              </Border.Background>
              <TextBlock Text="{x:Bind Name}" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis" />
            </Border>
          </Grid>
        </Border>
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="LibrarySourceTemplate" x:DataType="local:LibrarySourceItem">
      <Grid ColumnSpacing="12" Padding="4,6" AutomationProperties.Name="{x:Bind Name}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
        <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>

    <DataTemplate x:Key="LibraryGroupHeaderTemplate" x:DataType="local:LibraryRowGroup">
      <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,4">
        <TextBlock Text="{x:Bind Header}" Style="{ThemeResource SubtitleTextBlockStyle}" />
        <TextBlock Text="{x:Bind CountText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Bottom" Margin="0,0,0,3" />
      </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="LibraryGenericTemplate" x:DataType="local:LibraryRow">
      <Grid ColumnSpacing="12" Padding="2,7" AutomationProperties.Name="{x:Bind Name}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{x:Bind Detail}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind DetailVisibility}" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{x:Bind Extra}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </Grid>
    </DataTemplate>
  </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <MenuBar x:Name="Menu" Grid.Row="0" AutomationProperties.AutomationId="Menu" AutomationProperties.Name="Menu">
      <MenuBarItem x:Name="MediaMenu" Title="Media" AutomationProperties.AutomationId="MediaMenu" />
      <MenuBarItem x:Name="PlaybackMenu" Title="Playback" AutomationProperties.AutomationId="PlaybackMenu" />
      <MenuBarItem x:Name="AudioMenu" Title="Audio" AutomationProperties.AutomationId="AudioMenu" />
      <MenuBarItem x:Name="SubtitleMenu" Title="Subtitles" AutomationProperties.AutomationId="SubtitleMenu" />
      <MenuBarItem x:Name="VideoMenu" Title="Video" AutomationProperties.AutomationId="VideoMenu" />
      <MenuBarItem x:Name="ViewMenu" Title="View" AutomationProperties.AutomationId="ViewMenu" />
      <MenuBarItem x:Name="HelpMenu" Title="Help" AutomationProperties.AutomationId="HelpMenu" />
    </MenuBar>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Grid x:Name="Stage" Grid.Column="0" Background="Black" IsTabStop="True" DoubleTapped="OnStageDoubleTapped" PointerMoved="OnStagePointerMoved" PointerWheelChanged="OnStageWheel"
            AutomationProperties.AutomationId="Stage" AutomationProperties.Name="Picture">
        <SwapChainPanel x:Name="Video" AutomationProperties.AutomationId="Video" />
        <!-- Covers a presenter's late or remembered frame as soon as an audio-only item takes over. -->
        <Border x:Name="VideoBlankLayer" Background="Black" />

        <Grid x:Name="Visualizer" Visibility="Collapsed" IsHitTestVisible="False" Margin="48,120,48,48"
              AutomationProperties.AutomationId="Visualizer" AutomationProperties.Name="Visualisation">
          <Image x:Name="SpectrogramImage" Stretch="Fill" />
          <Canvas x:Name="VisualCanvas" />
        </Grid>

        <Grid x:Name="SubtitleLayer" IsHitTestVisible="False" AutomationProperties.AutomationId="Subtitles">
          <StackPanel x:Name="SubtitlesTop" VerticalAlignment="Top" HorizontalAlignment="Center" Spacing="2" />
          <StackPanel x:Name="SubtitlesMiddle" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2" />
          <StackPanel x:Name="SubtitlesBottom" VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="2" />
        </Grid>

        <!-- Before anything plays, a hint; while music plays, its picture and details (AU-19). -->
        <Grid x:Name="Idle" HorizontalAlignment="Center" VerticalAlignment="Center" ColumnSpacing="28" Margin="24" AutomationProperties.AutomationId="Idle">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border x:Name="CoverBox" Grid.Column="0" Width="200" Height="200" CornerRadius="8" Visibility="Collapsed" Background="#20FFFFFF">
            <Image x:Name="CoverImage" Stretch="UniformToFill" AutomationProperties.AutomationId="Cover" AutomationProperties.Name="Cover" />
          </Border>
          <StackPanel x:Name="IdleText" Grid.Column="1" VerticalAlignment="Center" Spacing="6" MaxWidth="560">
            <TextBlock x:Name="IdleTitle" AutomationProperties.AutomationId="IdleTitle" Text="rexplayer" FontSize="28" FontWeight="SemiBold" Foreground="White"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" />
            <TextBlock x:Name="IdleHint" Text="Drop media here, or press Ctrl+O to open a file." Foreground="#D0D8CE" HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.AutomationId="IdleHint" />
            <TextBlock x:Name="IdleAlbum" Foreground="#A0A8A0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                       Visibility="Collapsed" AutomationProperties.AutomationId="IdleAlbum" />
          </StackPanel>
        </Grid>

        <!-- Lyrics, the line being sung marked and kept in the middle (META-09). -->
        <ScrollViewer x:Name="LyricsBox" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="48,0,48,24" MaxWidth="720" CornerRadius="12"
                      VerticalScrollBarVisibility="Hidden" IsHitTestVisible="True" AutomationProperties.AutomationId="Lyrics" AutomationProperties.Name="Lyrics">
          <StackPanel x:Name="LyricsLines" Spacing="6" Padding="0,8" />
        </ScrollViewer>

        <InfoBar x:Name="ResumeBar" VerticalAlignment="Top" Margin="16" IsOpen="False" IsClosable="True" MaxWidth="560"
                 Title="Carry on where you left off?" AutomationProperties.AutomationId="ResumeBar" />

        <InfoBar x:Name="Notice" VerticalAlignment="Bottom" Margin="16" IsOpen="False" IsClosable="True" MaxWidth="720"
                 AutomationProperties.AutomationId="Notice" />

        <!-- The navigator: the presenter draws the whole picture here while zoomed; this frames it, marks the view and takes the pointer. -->
        <Grid x:Name="Navigator" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" Background="Transparent"
              BorderBrush="#E0FFFFFF" BorderThickness="1" AutomationProperties.AutomationId="Navigator" AutomationProperties.Name="Navigator">
          <Canvas>
            <Rectangle x:Name="NavigatorView" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2" Fill="#22FFFFFF" />
          </Canvas>
        </Grid>

        <Border x:Name="StatsBox" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" Padding="12,8" CornerRadius="8"
                Background="#C0080A09" Visibility="Collapsed" IsHitTestVisible="False">
          <TextBlock x:Name="Stats" Foreground="White" FontFamily="Cascadia Mono, Consolas" FontSize="12" AutomationProperties.AutomationId="Stats" />
        </Border>

        <Border x:Name="OsdBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Padding="12,6" CornerRadius="8"
                Background="#B0080A09" Visibility="Collapsed" IsHitTestVisible="False">
          <TextBlock x:Name="Osd" Foreground="White" FontSize="18" AutomationProperties.AutomationId="Osd"
                     AutomationProperties.LiveSetting="Polite" />
        </Border>
      </Grid>

      <!-- The media library (LIB-05), over the picture while it is open; what plays keeps playing. -->
      <Grid x:Name="LibraryPane" Grid.Column="0" Visibility="Collapsed" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
            AutomationProperties.AutomationId="LibraryPane" AutomationProperties.Name="Library">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="200" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListView x:Name="LibrarySources" Grid.Column="0" SelectionMode="Single" Padding="0,8" Background="{ThemeResource LayerFillColorDefaultBrush}"
                  ItemTemplate="{StaticResource LibrarySourceTemplate}"
                  SelectionChanged="OnLibrarySourceChanged" AutomationProperties.AutomationId="LibrarySources" AutomationProperties.Name="Library views" />

        <Grid Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- The view's banner: its artwork, blurred behind and sharp in front, its name, what it holds, and what to do with it. -->
          <Grid x:Name="LibraryHero" Height="196" AutomationProperties.AutomationId="LibraryHero">
            <Image x:Name="LibraryHeroBackdrop" Height="196" Stretch="UniformToFill" Opacity="0.6" />
            <Rectangle>
              <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#40000000" Offset="0" />
                  <GradientStop Color="{ThemeResource SolidBackgroundFillColorBase}" Offset="1" />
                </LinearGradientBrush>
              </Rectangle.Fill>
            </Rectangle>
            <Grid Padding="24,16,24,14" ColumnSpacing="22">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="LibraryHeroArtBox" Width="150" Height="150" CornerRadius="12" VerticalAlignment="Bottom" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid>
                  <FontIcon x:Name="LibraryHeroGlyph" Glyph="&#xE8D6;" FontSize="56" Opacity="0.45" />
                  <Image x:Name="LibraryHeroArt" Stretch="UniformToFill" />
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="LibraryBack" Visibility="Collapsed" Click="OnLibraryBack" AutomationProperties.AutomationId="LibraryBack" AutomationProperties.Name="Back"
                          ToolTipService.ToolTip="Back" Padding="8,4">
                    <FontIcon Glyph="&#xE72B;" FontSize="12" />
                  </Button>
                  <TextBlock x:Name="LibraryKicker" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" CharacterSpacing="80"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="LibraryKicker" />
                </StackPanel>
                <TextBlock x:Name="LibraryTitle" Style="{ThemeResource TitleLargeTextBlockStyle}" TextTrimming="CharacterEllipsis" MaxLines="1"
                           AutomationProperties.AutomationId="LibraryTitle" />
                <TextBlock x:Name="LibrarySubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                           AutomationProperties.AutomationId="LibrarySubtitle" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                  <Button x:Name="LibraryPlay" Click="OnLibraryPlay" Style="{ThemeResource AccentButtonStyle}" AutomationProperties.AutomationId="LibraryPlay"
                          ToolTipService.ToolTip="Play the chosen items, or all of them (Enter)">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE768;" FontSize="14" /><TextBlock Text="Play" /></StackPanel>
                  </Button>
                  <Button x:Name="LibraryShuffle" Click="OnLibraryShuffle" AutomationProperties.AutomationId="LibraryShuffle" ToolTipService.ToolTip="Play the chosen items, or all of them, shuffled">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8B1;" FontSize="14" /><TextBlock Text="Shuffle" /></StackPanel>
                  </Button>
                  <Button x:Name="LibraryEnqueue" Click="OnLibraryEnqueue" AutomationProperties.AutomationId="LibraryEnqueue" ToolTipService.ToolTip="Add the chosen items, or all of them, to the end of the playlist">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="14" /><TextBlock Text="Add to the playlist" /></StackPanel>
                  </Button>
                  <StackPanel x:Name="LibraryFolderActions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <Button x:Name="LibraryAddFolder" Content="Add a folder..." Click="OnLibraryAddFolder" AutomationProperties.AutomationId="LibraryAddFolder" />
                    <Button x:Name="LibraryRemoveFolder" Content="Stop watching" Click="OnLibraryRemoveFolder" AutomationProperties.AutomationId="LibraryRemoveFolder"
                            ToolTipService.ToolTip="The library forgets the chosen folders; the files stay where they are" />
                    <Button x:Name="LibraryRescan" Content="Look again" Click="OnLibraryRescan" AutomationProperties.AutomationId="LibraryRescan"
                            ToolTipService.ToolTip="Look through every folder for files added, changed or removed" />
                    <Button x:Name="LibraryBackUp" Content="Back up..." Click="OnLibraryBackUp" AutomationProperties.AutomationId="LibraryBackUp"
                            ToolTipService.ToolTip="Keep the library, its play counts and your playlists in a folder you choose" />
                    <Button x:Name="LibraryRestore" Content="Bring back..." Click="OnLibraryRestore" AutomationProperties.AutomationId="LibraryRestore"
                            ToolTipService.ToolTip="Add a backup's folders, play counts and playlists to the library" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Grid>

          <!-- How the view is shown: its layout, order, grouping and card size, each kept per view. -->
          <Grid Grid.Row="1" Padding="24,6,24,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <DropDownButton x:Name="LibraryLookButton" AutomationProperties.AutomationId="LibraryLook" ToolTipService.ToolTip="How the view is laid out" />
            <DropDownButton x:Name="LibrarySortButton" Grid.Column="1" AutomationProperties.AutomationId="LibrarySort" ToolTipService.ToolTip="What the view is ordered by" />
            <DropDownButton x:Name="LibraryGroupButton" Grid.Column="2" AutomationProperties.AutomationId="LibraryGroup" ToolTipService.ToolTip="What the view is gathered under" />
            <StackPanel x:Name="LibrarySizePanel" Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0,0,0">
              <FontIcon Glyph="&#xE71E;" FontSize="12" Opacity="0.7" />
              <Slider x:Name="LibraryCardSize" Width="110" Minimum="120" Maximum="360" StepFrequency="10" VerticalAlignment="Center"
                      ValueChanged="OnLibraryCardSizeChanged" AutomationProperties.AutomationId="LibraryCardSize" AutomationProperties.Name="Card size" />
            </StackPanel>
            <TextBlock x:Name="LibraryStatus" Grid.Column="4" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" Margin="8,0" AutomationProperties.AutomationId="LibraryStatus" />
            <TextBox x:Name="LibrarySearch" Grid.Column="5" Width="260" PlaceholderText="Search the library" TextChanged="OnLibrarySearchChanged"
                     AutomationProperties.AutomationId="LibrarySearch" AutomationProperties.Name="Search the library" />
          </Grid>

          <ListView x:Name="LibraryList" Grid.Row="2" Padding="18,0,18,8" SelectionMode="Extended" IsItemClickEnabled="False" DoubleTapped="OnLibraryDoubleTapped" KeyDown="OnLibraryKeyDown"
                     ScrollViewer.VerticalScrollMode="Enabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ItemTemplate="{StaticResource LibrarySongTemplate}" ItemsPanel="{StaticResource LibraryListPanel}"
                    AutomationProperties.AutomationId="LibraryList" AutomationProperties.Name="Songs, compact list" />

          <!-- Home: shelves of what to play next. -->
          <ScrollViewer x:Name="LibraryHome" Grid.Row="2" Visibility="Collapsed" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                         AutomationProperties.AutomationId="LibraryHome">
            <StackPanel x:Name="LibraryShelves" Spacing="22" Padding="24,4,24,24" />
          </ScrollViewer>

          <StackPanel x:Name="LibraryEmpty" Grid.Row="2" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="440">
            <TextBlock x:Name="LibraryEmptyText" TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.AutomationId="LibraryEmptyText" />
            <StackPanel x:Name="LibraryFolderButtons" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" />
          </StackPanel>
        </Grid>
      </Grid>

      <Grid x:Name="PlaylistPane" Grid.Column="1" Width="320" Visibility="Collapsed" Padding="8"
            Background="{ThemeResource LayerFillColorDefaultBrush}" AutomationProperties.AutomationId="PlaylistPane">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Text="Playlist" Style="{ThemeResource SubtitleTextBlockStyle}" Margin="4,0,0,8" />
        <ListView x:Name="PlaylistView" Grid.Row="1" SelectionMode="Extended" IsItemClickEnabled="False" CanReorderItems="False"
                  DoubleTapped="OnPlaylistDoubleTapped" KeyDown="OnPlaylistKeyDown"
                  AutomationProperties.AutomationId="PlaylistView" AutomationProperties.Name="Playlist">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="local:PlaylistRow">
              <Grid ColumnSpacing="10" Padding="0,3" Opacity="{x:Bind Opacity}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="64" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="64" Height="36" CornerRadius="4" Background="{ThemeResource LayerFillColorDefaultBrush}">
                  <Grid>
                    <TextBlock Text="{x:Bind Placeholder}" FontSize="16" Opacity="0.38" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{x:Bind Picture, Mode=OneWay}" Stretch="UniformToFill" />
                  </Grid>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="{x:Bind Text}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="(missing)" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind MissingVisibility}" />
                </StackPanel>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
      </Grid>
    </Grid>

    <Grid x:Name="Controls" Grid.Row="2" Padding="12,4,12,8" ColumnSpacing="8" VerticalAlignment="Bottom">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <TextBlock x:Name="Elapsed" Grid.Row="0" Grid.Column="0" Text="0:00" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas"
                 AutomationProperties.AutomationId="Elapsed" />
      <Grid x:Name="SeekArea" Grid.Row="0" Grid.Column="1" SizeChanged="OnSeekAreaSizeChanged"
            PointerMoved="OnSeekAreaPointerMoved" PointerExited="OnSeekAreaPointerExited">
        <Slider x:Name="SeekBar" Minimum="0" Maximum="1" StepFrequency="0.1" IsEnabled="False" IsThumbToolTipEnabled="False"
                ValueChanged="OnSeekBarChanged" IsTabStop="True" AutomationProperties.AutomationId="SeekBar" AutomationProperties.Name="Position" />
        <!-- Bookmark buttons sit above the rail. Their transparent 16-pixel hit targets are much
             easier to point at than their precise 3-pixel marks. -->
        <Canvas x:Name="BookmarkMarkers" Height="28" VerticalAlignment="Center" AutomationProperties.AutomationId="BookmarkMarkers"
                AutomationProperties.Name="Bookmarks on the timeline" />
        <Border x:Name="SeekPreview" Width="192" Padding="6" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="0,0,0,30" Background="#E6101110" BorderBrush="#55FFFFFF" BorderThickness="1" Visibility="Collapsed"
                IsHitTestVisible="False" Canvas.ZIndex="20" AutomationProperties.AutomationId="SeekPreview" AutomationProperties.Name="Timeline preview">
          <StackPanel Spacing="5">
            <Border x:Name="SeekPreviewPicture" Width="178" Height="100" CornerRadius="5" Background="Black" Visibility="Collapsed">
              <Image x:Name="SeekPreviewImage" Stretch="UniformToFill" />
            </Border>
            <TextBlock x:Name="SeekPreviewTime" Foreground="White" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold"
                       HorizontalAlignment="Center" AutomationProperties.AutomationId="SeekPreviewTime" />
          </StackPanel>
        </Border>
      </Grid>
      <TextBlock x:Name="Remaining" Grid.Row="0" Grid.Column="2" Text="0:00" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas"
                 Tapped="OnRemainingTapped" AutomationProperties.AutomationId="Remaining" />

      <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="4">
        <Button x:Name="PreviousButton" Click="OnPrevious" AutomationProperties.AutomationId="PreviousButton" AutomationProperties.Name="Previous">
          <FontIcon Glyph="&#xE892;" />
        </Button>
        <Button x:Name="PlayPauseButton" Click="OnPlayPause" AutomationProperties.AutomationId="PlayPauseButton" AutomationProperties.Name="Play">
          <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" />
        </Button>
        <Button x:Name="StopButton" Click="OnStop" AutomationProperties.AutomationId="StopButton" AutomationProperties.Name="Stop">
          <FontIcon Glyph="&#xE71A;" />
        </Button>
        <Button x:Name="NextButton" Click="OnNext" AutomationProperties.AutomationId="NextButton" AutomationProperties.Name="Next">
          <FontIcon Glyph="&#xE893;" />
        </Button>
        <AppBarSeparator />
        <ToggleButton x:Name="ShuffleButton" Click="OnShuffle" AutomationProperties.AutomationId="ShuffleButton" AutomationProperties.Name="Shuffle">
          <FontIcon Glyph="&#xE8B1;" />
        </ToggleButton>
        <ToggleButton x:Name="RepeatButton" Click="OnRepeat" AutomationProperties.AutomationId="RepeatButton" AutomationProperties.Name="Repeat off">
          <FontIcon x:Name="RepeatIcon" Glyph="&#xE8EE;" />
        </ToggleButton>
        <ToggleButton x:Name="PlaylistButton" Click="OnTogglePlaylist" AutomationProperties.AutomationId="PlaylistButton" AutomationProperties.Name="Playlist">
          <FontIcon Glyph="&#xE8FD;" />
        </ToggleButton>
        <ToggleButton x:Name="LibraryButton" Click="OnToggleLibrary" AutomationProperties.AutomationId="LibraryButton" AutomationProperties.Name="Library">
          <FontIcon Glyph="&#xE8F1;" />
        </ToggleButton>
        <Button x:Name="FullScreenButton" Click="OnFullScreen" AutomationProperties.AutomationId="FullScreenButton" AutomationProperties.Name="Full screen">
          <FontIcon x:Name="FullScreenIcon" Glyph="&#xE740;" />
        </Button>
        <TextBlock x:Name="NowPlaying" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="480"
                   AutomationProperties.AutomationId="NowPlaying" />
      </StackPanel>

      <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="4">
        <Button x:Name="SpeedButton" Content="1×" MinWidth="52" Click="OnSpeedButton" VerticalAlignment="Center"
                AutomationProperties.AutomationId="SpeedButton" AutomationProperties.Name="Playback speed, 1×"
                ToolTipService.ToolTip="Choose playback speed" />
        <Button x:Name="MuteButton" Click="OnMute" AutomationProperties.AutomationId="MuteButton" AutomationProperties.Name="Mute">
          <FontIcon x:Name="MuteIcon" Glyph="&#xE767;" />
        </Button>
        <Slider x:Name="VolumeBar" Width="120" Minimum="0" Maximum="200" StepFrequency="1" VerticalAlignment="Center" ValueChanged="OnVolumeChanged"
                AutomationProperties.AutomationId="VolumeBar" AutomationProperties.Name="Volume" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>

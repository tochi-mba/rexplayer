<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Rex.Media.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Rex.Media.App">
  <Grid x:Name="Root" AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop">
  <Grid.Resources>
    <!-- Each medium gets the density and visual hierarchy that suits it, while all four panels
         remain virtualised ListView panels with the same keyboard and screen-reader behaviour. -->
    <ItemsPanelTemplate x:Key="LibraryListPanel"><ItemsStackPanel Orientation="Vertical" /></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="LibraryBrowsePanel"><ItemsWrapGrid Orientation="Horizontal" ItemWidth="196" ItemHeight="246" /></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="LibraryVideoPanel"><ItemsWrapGrid Orientation="Horizontal" ItemWidth="270" ItemHeight="218" /></ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="LibraryPhotoPanel"><ItemsWrapGrid Orientation="Horizontal" ItemWidth="226" ItemHeight="220" /></ItemsPanelTemplate>
    <DataTemplate x:Key="LibrarySongTemplate" x:DataType="local:LibraryRow">
      <Grid ColumnSpacing="12" Padding="2,5" MinHeight="64" AutomationProperties.Name="{x:Bind AccessibilityName, Mode=OneWay}" AutomationProperties.HelpText="{x:Bind TranscriptText, Mode=OneWay}"
            PointerEntered="OnCardPointerEntered" PointerExited="OnCardPointerExited">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="32" />
          <ColumnDefinition Width="54" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="{x:Bind Badge}" Visibility="{x:Bind BadgeVisibility}" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Cascadia Mono, Consolas" />
        <Border Grid.Column="1" Width="54" Height="54" CornerRadius="5" Background="{ThemeResource LayerFillColorDefaultBrush}">
          <Grid>
            <TextBlock Text="{x:Bind PicturePlaceholder}" FontSize="22" Opacity="0.38" HorizontalAlignment="Center" VerticalAlignment="Center" />
            <Image Source="{x:Bind Picture, Mode=OneWay}" Stretch="UniformToFill" Opacity="{x:Bind PictureOpacity, Mode=OneWay}">
              <Image.OpacityTransition><ScalarTransition Duration="0:0:0.2" /></Image.OpacityTransition>
            </Image>
            <ProgressRing Visibility="{x:Bind DownloadVisibility, Mode=OneWay}" Value="{x:Bind DownloadPercent, Mode=OneWay}" IsIndeterminate="False" Maximum="100" Width="22" Height="22" Margin="3"
                          HorizontalAlignment="Right" VerticalAlignment="Top" Foreground="White" Background="#C0181818" IsHitTestVisible="False"
                          ToolTipService.ToolTip="{x:Bind DownloadText, Mode=OneWay}" AutomationProperties.AutomationId="LibraryDownloadBadge" AutomationProperties.Name="{x:Bind DownloadText, Mode=OneWay}" />
            <FontIcon Glyph="&#xE896;" Visibility="{x:Bind DownloadVisibility, Mode=OneWay}" FontSize="9" Foreground="White" Width="22" Height="22" Margin="3" HorizontalAlignment="Right" VerticalAlignment="Top" />
          </Grid>
        </Border>
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
          <TextBlock Text="{x:Bind Detail, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind DetailVisibility, Mode=OneWay}" />
        </StackPanel>
        <!-- Quick actions show on the line pointed at or focused, exactly like a card's play mark. -->
        <StackPanel x:Name="CardPlay" Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Opacity="0">
          <Button Padding="7" Background="Transparent" BorderThickness="0" Click="OnRowPlay" IsTabStop="False" AllowFocusOnInteraction="False"
                  AutomationProperties.AutomationId="LibraryRowPlay" AutomationProperties.Name="Play" ToolTipService.ToolTip="Play this, with the rest of the view after it">
            <FontIcon Glyph="&#xE768;" FontSize="14" />
          </Button>
          <Button Padding="7" Background="Transparent" BorderThickness="0" Click="OnRowQueue" IsTabStop="False" AllowFocusOnInteraction="False"
                  AutomationProperties.AutomationId="LibraryRowQueue" AutomationProperties.Name="Add to queue" ToolTipService.ToolTip="Add to the end of the playlist">
            <FontIcon Glyph="&#xE710;" FontSize="14" />
          </Button>
        </StackPanel>
        <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <FontIcon Glyph="{x:Bind TranscriptGlyph, Mode=OneWay}" Visibility="{x:Bind TranscriptVisibility, Mode=OneWay}" FontSize="13"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" ToolTipService.ToolTip="{x:Bind TranscriptText, Mode=OneWay}"
                    AutomationProperties.AutomationId="LibraryTranscriptBadge" AutomationProperties.Name="{x:Bind TranscriptText, Mode=OneWay}" />
          <TextBlock Text="{x:Bind Extra}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontFamily="Cascadia Mono, Consolas" />
        </StackPanel>
        <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Visibility="{x:Bind PlayingVisibility, Mode=OneWay}">
          <FontIcon Glyph="&#xE768;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
          <TextBlock Text="Now playing" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        </StackPanel>
      </Grid>
    </DataTemplate>
    <!-- The card and grid templates live in LibraryCardTemplates.xaml, loaded when the library first lays out cards. -->
    <DataTemplate x:Key="LibrarySourceTemplate" x:DataType="local:LibrarySourceItem">
      <Grid ColumnSpacing="12" Padding="4,6" AutomationProperties.Name="{x:Bind Name}" ToolTipService.ToolTip="{x:Bind Name}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="20" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" />
        <TextBlock Grid.Column="1" Text="{x:Bind Name}" VerticalAlignment="Center" />
      </Grid>
    </DataTemplate>
    <!-- One full-width, keyboard-operable group header; the chevron, heading and total all click. -->
    <DataTemplate x:Key="LibraryGroupHeaderTemplate" x:DataType="local:LibraryRowGroup">
      <Button Tag="{Binding}" Click="OnLibraryGroupToggle" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
              BorderThickness="0" Background="Transparent" Padding="4,8" Margin="0,4,0,2"
              AutomationProperties.AutomationId="{x:Bind ToggleId}"
              AutomationProperties.Name="{x:Bind ToggleName, Mode=OneWay}"
              ToolTipService.ToolTip="{x:Bind ToggleName, Mode=OneWay}">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <FontIcon Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          <TextBlock Text="{x:Bind Header}" Style="{ThemeResource SubtitleTextBlockStyle}" />
          <TextBlock Text="{x:Bind CountText}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </DataTemplate>
    <DataTemplate x:Key="LibraryGenericTemplate" x:DataType="local:LibraryRow">
      <Grid ColumnSpacing="12" Padding="2,7" AutomationProperties.Name="{x:Bind Name}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
          <TextBlock Text="{x:Bind Detail}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis" Visibility="{x:Bind DetailVisibility}" />
        </StackPanel>
        <TextBlock Grid.Column="1" Text="{x:Bind Extra}" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
      </Grid>
    </DataTemplate>
  </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <MenuBar x:Name="Menu" Grid.Row="0" AutomationProperties.AutomationId="Menu" AutomationProperties.Name="Menu">
      <MenuBarItem x:Name="MediaMenu" Title="Media" AutomationProperties.AutomationId="MediaMenu" />
      <MenuBarItem x:Name="PlaybackMenu" Title="Playback" AutomationProperties.AutomationId="PlaybackMenu" />
      <MenuBarItem x:Name="AudioMenu" Title="Audio" AutomationProperties.AutomationId="AudioMenu" />
      <MenuBarItem x:Name="SubtitleMenu" Title="Subtitles" AutomationProperties.AutomationId="SubtitleMenu" />
      <MenuBarItem x:Name="VideoMenu" Title="Video" AutomationProperties.AutomationId="VideoMenu" />
      <MenuBarItem x:Name="ViewMenu" Title="View" AutomationProperties.AutomationId="ViewMenu" />
      <MenuBarItem x:Name="HelpMenu" Title="Help" AutomationProperties.AutomationId="HelpMenu" />
    </MenuBar>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <Grid x:Name="Stage" Grid.Column="0" Background="Black" IsTabStop="True" DoubleTapped="OnStageDoubleTapped" PointerMoved="OnStagePointerMoved" PointerExited="OnStagePointerExited" PointerWheelChanged="OnStageWheel"
            AutomationProperties.AutomationId="Stage" AutomationProperties.Name="Picture">
        <SwapChainPanel x:Name="Video" AutomationProperties.AutomationId="Video" />
        <!-- Covers a presenter's late or remembered frame as soon as an audio-only item takes over. -->
        <Border x:Name="VideoBlankLayer" Background="Black" />
        <Grid x:Name="Visualizer" Visibility="Collapsed" IsHitTestVisible="False" Margin="48,120,48,48"
              AutomationProperties.AutomationId="Visualizer" AutomationProperties.Name="Visualisation">
          <Image x:Name="SpectrogramImage" Stretch="Fill" />
          <Canvas x:Name="VisualCanvas" />
        </Grid>
        <!-- Subject Lock is separate from the Ghostwire visual effect. The overlay shows the
             deliberately selected region and whether tracking is still confident. -->
        <Canvas x:Name="SubjectCanvas" IsHitTestVisible="False" Visibility="Collapsed">
          <Border x:Name="SubjectOutline" BorderBrush="#FF45ECD2" BorderThickness="2" CornerRadius="3"
                  Background="#2045ECD2" Width="1" Height="1" />
        </Canvas>
        <!-- The Subject Lock panel: a header with the state and the primary action, then
             collapsible sections. It docks to a side of the stage so it never covers the middle
             of the picture, and its content scrolls on short windows. -->
        <Border x:Name="SubjectToolbar" Visibility="Collapsed" VerticalAlignment="Top"
                HorizontalAlignment="Right" Margin="12" Width="320" CornerRadius="12"
                Background="#F0121822" BorderBrush="#605FFFFF" BorderThickness="1" RequestedTheme="Dark"
                AutomationProperties.AutomationId="SubjectToolbar" AutomationProperties.Name="Subject Lock">
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                        VerticalScrollMode="Enabled">
            <StackPanel Spacing="8" Padding="12,10,12,12">
              <Grid ColumnSpacing="6" RowSpacing="8">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="4" VerticalAlignment="Center">
                  <TextBlock Text="Subject Lock" FontWeight="SemiBold" Foreground="White" FontSize="15" />
                  <Border x:Name="SubjectStatePill" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left"
                          Background="#3045ECD2" AutomationProperties.AutomationId="SubjectStatePill">
                    <TextBlock x:Name="SubjectConfidenceText" Foreground="#FF45ECD2" FontSize="12"
                               AutomationProperties.AutomationId="SubjectConfidenceText"
                               AutomationProperties.Name="Tracking state"
                               AutomationProperties.LiveSetting="Polite"
                               TextWrapping="Wrap" Text="Waiting for selection" />
                  </Border>
                </StackPanel>
                <Button x:Name="SubjectSelectButton" Grid.Row="1" Grid.ColumnSpan="2" Content="Select" HorizontalAlignment="Stretch"
                        Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Top"
                        Click="OnSubjectSelect" AutomationProperties.AutomationId="SubjectSelect"
                        AutomationProperties.Name="Select an object in the picture" />
                <Button Grid.Column="1" Content="Close" VerticalAlignment="Top" Click="OnSubjectClose"
                        ToolTipService.ToolTip="Close Subject Lock (Escape)"
                        AutomationProperties.AutomationId="SubjectClose"
                        AutomationProperties.Name="Close Subject Lock" />
              </Grid>
              <TextBlock x:Name="SubjectStatusText" Foreground="#FFE0EAF0" TextWrapping="Wrap" FontSize="13"
                         AutomationProperties.AutomationId="SubjectStatusText"
                         AutomationProperties.LiveSetting="Polite"
                         Text="Click the object you want to follow, or drag a box around it." />
              <Grid ColumnSpacing="6" RowSpacing="6">
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Reset" HorizontalAlignment="Stretch" Click="OnSubjectReset"
                        AutomationProperties.AutomationId="SubjectReset"
                        AutomationProperties.Name="Reset the selection" />
                <Button Grid.Column="1" Content="Lock centre" HorizontalAlignment="Stretch" Click="OnSubjectCenter"
                        AutomationProperties.AutomationId="SubjectCenter"
                        AutomationProperties.Name="Lock visible centre of picture"
                        ToolTipService.ToolTip="Locks the middle of the visible picture, for the keyboard" />
                <Button x:Name="SubjectMoveButton" Grid.Row="1" Grid.ColumnSpan="2" Content="Move left" HorizontalAlignment="Stretch"
                        Click="OnSubjectMove" AutomationProperties.AutomationId="SubjectMove"
                        AutomationProperties.Name="Move the panel to the other side" />
              </Grid>
              <ToggleSwitch x:Name="SubjectClickToLock" Header="Selection" IsOn="True"
                            OnContent="Click to lock" OffContent="Draw a box"
                            Toggled="OnSubjectModeChanged" AutomationProperties.AutomationId="SubjectClickToLock"
                            AutomationProperties.Name="Click to lock; off to draw a box instead" />
              <Expander x:Name="SubjectFollowingSection" Header="Following" IsExpanded="True"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Expanding="OnSubjectExpanding" Collapsed="OnSubjectCollapsed"
                        AutomationProperties.AutomationId="SubjectFollowingSection"
                        AutomationProperties.Name="Following">
                <StackPanel Spacing="4">
                  <ToggleSwitch x:Name="SubjectFollow" Header="Auto-follow" IsOn="True"
                                OnContent="Gentle zoom, at most 1.85x" OffContent="View stays where you put it"
                                Toggled="OnSubjectFollowChanged" AutomationProperties.AutomationId="SubjectFollow"
                                AutomationProperties.Name="Automatically follow the selected object with a gentle zoom" />
                  <ToggleSwitch x:Name="SubjectShowBox" Header="Tracking box" IsOn="True"
                                OnContent="Shown" OffContent="Hidden; tracking continues"
                                Toggled="OnSubjectShowBoxChanged" AutomationProperties.AutomationId="SubjectShowBox"
                                AutomationProperties.Name="Show the tracking box; tracking continues when hidden" />
                  <TextBlock Text="Zooming or panning by hand switches auto-follow off until you turn it on again."
                             Foreground="#FFC2C9D4" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
              </Expander>
              <Expander x:Name="SubjectRemovalSection" Header="Removal preview" IsExpanded="True"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Expanding="OnSubjectExpanding" Collapsed="OnSubjectCollapsed"
                        AutomationProperties.AutomationId="SubjectRemovalSection"
                        AutomationProperties.Name="Removal preview">
                <StackPanel Spacing="4">
                  <RadioButtons x:Name="SubjectRemovalMode" MaxColumns="2" SelectionChanged="OnSubjectRemovalModeChanged"
                                AutomationProperties.AutomationId="SubjectRemovalMode" AutomationProperties.Name="Removal mode">
                    <RadioButton x:Name="SubjectRemovalModeRemove" Content="Remove" Foreground="#FFE0EAF0"
                                 AutomationProperties.AutomationId="SubjectRemovalModeRemove" />
                    <RadioButton x:Name="SubjectRemovalModeBlend" Content="Blend" Foreground="#FFE0EAF0"
                                 AutomationProperties.AutomationId="SubjectRemovalModeBlend" />
                  </RadioButtons>
                  <TextBlock x:Name="SubjectRemovalDescription" Foreground="#FFC2C9D4" FontSize="12" TextWrapping="Wrap"
                             AutomationProperties.AutomationId="SubjectRemovalDescription" />
                  <Button x:Name="SubjectEraseButton" Content="Preview removal" HorizontalAlignment="Stretch"
                          Click="OnSubjectErase" IsEnabled="False"
                          AutomationProperties.AutomationId="SubjectErase"
                          AutomationProperties.Name="Preview removing the subject; the file is not changed" />
                  <TextBlock x:Name="SubjectFillText" Foreground="#FF45ECD2" FontSize="12" TextWrapping="Wrap"
                             AutomationProperties.AutomationId="SubjectFillText"
                             AutomationProperties.LiveSetting="Polite"
                             AutomationProperties.Name="Where the removal fill comes from" />
                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SubjectToleranceLabel" Foreground="#FFE0EAF0" FontSize="13" VerticalAlignment="Bottom" />
                    <TextBlock x:Name="SubjectToleranceText" Grid.Column="1" Text="50%, balanced" Foreground="#FF45ECD2" FontSize="13"
                               VerticalAlignment="Bottom" AutomationProperties.AutomationId="SubjectToleranceText"
                               AutomationProperties.Name="Subject coverage value" />
                  </Grid>
                  <Slider x:Name="SubjectTolerance" Minimum="0" Maximum="100" Value="50" StepFrequency="5"
                          ValueChanged="OnSubjectMaskChanged" AutomationProperties.AutomationId="SubjectTolerance"
                          AutomationProperties.Name="Subject coverage" />
                  <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="SubjectFeatherLabel" Foreground="#FFE0EAF0" FontSize="13" VerticalAlignment="Bottom" />
                    <TextBlock x:Name="SubjectFeatherText" Grid.Column="1" Text="3 px" Foreground="#FF45ECD2" FontSize="13"
                               VerticalAlignment="Bottom" AutomationProperties.AutomationId="SubjectFeatherText"
                               AutomationProperties.Name="Edge softness value" />
                  </Grid>
                  <Slider x:Name="SubjectFeather" Minimum="0" Maximum="12" Value="3" StepFrequency="1"
                          ValueChanged="OnSubjectMaskChanged" AutomationProperties.AutomationId="SubjectFeather"
                          AutomationProperties.Name="Edge softness" />
                  <TextBlock x:Name="SubjectRemovalNote" Foreground="#FFC2C9D4" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
              </Expander>
              <Expander x:Name="SubjectHelpSection" Header="Help" IsExpanded="False"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Expanding="OnSubjectExpanding" Collapsed="OnSubjectCollapsed"
                        AutomationProperties.AutomationId="SubjectHelpSection"
                        AutomationProperties.Name="Help">
                <TextBlock x:Name="SubjectHelpText" Foreground="#FFC2C9D4" FontSize="12" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="SubjectHelpText"
                           AutomationProperties.Name="Subject Lock help" />
              </Expander>
            </StackPanel>
          </ScrollViewer>
        </Border>
        <!-- Kinetic captions (OSD-11): words placed and moved by MainWindow.KineticCaptions.cs. -->
        <Canvas x:Name="KineticLayer" IsHitTestVisible="False" Visibility="Collapsed" AutomationProperties.AutomationId="KineticCaptions" />
        <Grid x:Name="SubtitleLayer" IsHitTestVisible="False" AutomationProperties.AutomationId="Subtitles">
          <StackPanel x:Name="SubtitlesTop" VerticalAlignment="Top" HorizontalAlignment="Center" Spacing="2" />
          <StackPanel x:Name="SubtitlesMiddle" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="2" />
          <StackPanel x:Name="SubtitlesBottom" VerticalAlignment="Bottom" HorizontalAlignment="Center" Spacing="2" />
        </Grid>
        <!-- Before anything plays, a hint; while music plays, its picture and details (AU-19). -->
        <Grid x:Name="Idle" HorizontalAlignment="Center" VerticalAlignment="Center" ColumnSpacing="32" Margin="32" AutomationProperties.AutomationId="Idle">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border x:Name="CoverBox" Grid.Column="0" Width="240" Height="240" CornerRadius="18" Visibility="Collapsed"
                  Background="#20FFFFFF" BorderBrush="#24FFFFFF" BorderThickness="1">
            <Image x:Name="CoverImage" Stretch="UniformToFill" AutomationProperties.AutomationId="Cover" AutomationProperties.Name="Cover" />
          </Border>
          <StackPanel x:Name="IdleText" Grid.Column="1" VerticalAlignment="Center" Spacing="7" MaxWidth="560">
            <TextBlock x:Name="IdleKicker" Text="WELCOME" FontSize="11" FontWeight="SemiBold" CharacterSpacing="120"
                       Foreground="{ThemeResource AccentFillColorDefaultBrush}" HorizontalAlignment="Center" TextAlignment="Center"
                       AutomationProperties.AutomationId="IdleKicker" />
            <TextBlock x:Name="IdleTitle" AutomationProperties.AutomationId="IdleTitle" Text="rexplayer" FontSize="34" FontWeight="SemiBold" Foreground="White"
                       HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxLines="2" TextTrimming="CharacterEllipsis" />
            <TextBlock x:Name="IdleHint" Text="Drop media here, or press Ctrl+O to open a file." Foreground="#D0D8CE" HorizontalAlignment="Center"
                       TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.AutomationId="IdleHint" />
            <TextBlock x:Name="IdleAlbum" Foreground="#A0A8A0" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                       Visibility="Collapsed" AutomationProperties.AutomationId="IdleAlbum" />
            <TextBlock x:Name="IdleMeta" Foreground="#90FFFFFF" FontSize="12" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                       Visibility="Collapsed" AutomationProperties.AutomationId="IdleMeta" />
          </StackPanel>
        </Grid>
        <!-- Lyrics, the line being sung marked and kept in the middle (META-09). -->
        <ScrollViewer x:Name="LyricsBox" Visibility="Collapsed" VerticalAlignment="Bottom" Margin="48,0,48,24" MaxWidth="720" CornerRadius="12"
                      VerticalScrollBarVisibility="Hidden" IsHitTestVisible="True" AutomationProperties.AutomationId="Lyrics" AutomationProperties.Name="Lyrics">
          <StackPanel x:Name="LyricsLines" Spacing="6" Padding="0,8" />
        </ScrollViewer>
        <!-- A held viewer should not have to infer from the small timeline rail that captions are
             being prepared. Keep the explanation central and offer an immediate, explicit escape. -->
        <Border x:Name="CaptionBufferOverlay" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                MaxWidth="420" Margin="24" Padding="22,18" CornerRadius="16" Background="#F20B0D0C"
                BorderBrush="#40FFFFFF" BorderThickness="1" Canvas.ZIndex="30"
                AutomationProperties.AutomationId="CaptionBufferOverlay" AutomationProperties.Name="Preparing captions">
          <StackPanel Spacing="12" HorizontalAlignment="Center">
            <ProgressRing IsActive="True" Width="34" Height="34" HorizontalAlignment="Center"
                          AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Text="Preparing captions" FontSize="18" FontWeight="SemiBold" Foreground="White"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="CaptionBufferOverlayText" Foreground="#FFD6DAD7" TextAlignment="Center"
                       TextWrapping="Wrap" AutomationProperties.AutomationId="CaptionBufferOverlayText"
                       AutomationProperties.LiveSetting="Polite" />
            <Button Content="Play now" HorizontalAlignment="Center" Click="OnPlayWithoutCaptionBuffer"
                    AutomationProperties.AutomationId="CaptionBufferPlayNow"
                    AutomationProperties.Name="Play now without waiting for more captions" />
          </StackPanel>
        </Border>

        <!-- A growing local file can temporarily run out of downloaded bytes without being over.
             Make that recoverable wait explicit instead of leaving a frozen picture on screen. -->
        <Border x:Name="DownloadBufferOverlay" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center"
                MaxWidth="420" Margin="24" Padding="22,18" CornerRadius="16" Background="#F20B0D0C"
                BorderBrush="#40FFFFFF" BorderThickness="1" Canvas.ZIndex="30"
                AutomationProperties.AutomationId="DownloadBufferOverlay" AutomationProperties.Name="Waiting for download">
          <StackPanel Spacing="12" HorizontalAlignment="Center">
            <ProgressRing x:Name="DownloadBufferProgress" IsActive="True" Width="34" Height="34" HorizontalAlignment="Center"
                          AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Text="Waiting for the download" FontSize="18" FontWeight="SemiBold" Foreground="White"
                       HorizontalAlignment="Center" />
            <TextBlock x:Name="DownloadBufferOverlayText" Text="Playback will continue automatically when more of the file is available."
                       Foreground="#FFD6DAD7" TextAlignment="Center" TextWrapping="Wrap"
                       AutomationProperties.AutomationId="DownloadBufferOverlayText"
                       AutomationProperties.LiveSetting="Polite" />
          </StackPanel>
        </Border>


        <InfoBar x:Name="Notice" VerticalAlignment="Bottom" Margin="16" IsOpen="False" IsClosable="True" MaxWidth="720"
                 AutomationProperties.AutomationId="Notice" />

        <!-- The navigator: the presenter draws the whole picture here while zoomed; this frames it, marks the view and takes the pointer. -->
        <Grid x:Name="Navigator" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" Background="Transparent"
              BorderBrush="#E0FFFFFF" BorderThickness="1" AutomationProperties.AutomationId="Navigator" AutomationProperties.Name="Navigator">
          <Canvas>
            <Rectangle x:Name="NavigatorView" Stroke="{ThemeResource AccentFillColorDefaultBrush}" StrokeThickness="2" Fill="#22FFFFFF" />
          </Canvas>
        </Grid>

        <!-- Skip intro / Skip credits / Next episode, bottom right above the controls. The options
             button beside them confirms, adjusts or rejects the section; Cancel shows only while an
             opted-in automatic skip counts down. -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,24,90" Spacing="8">
          <DropDownButton x:Name="EpisodeSkipOptions" Visibility="Collapsed"
                          Padding="10,10" CornerRadius="12"
                          AutomationProperties.AutomationId="EpisodeSkipOptions"
                          AutomationProperties.Name="Review the detected section"
                          ToolTipService.ToolTip="Save, adjust or reject this section">
            <FontIcon Glyph="&#xE712;" FontSize="14" />
          </DropDownButton>
          <Button x:Name="EpisodeSkipCancel" Content="Cancel" Visibility="Collapsed"
                  Padding="16,10" CornerRadius="12" Click="OnCancelAutomaticSkip"
                  AutomationProperties.AutomationId="EpisodeSkipCancel"
                  AutomationProperties.Name="Cancel the automatic skip"
                  ToolTipService.ToolTip="Keep watching; do not skip this time" />
          <Button x:Name="EpisodeNextButton" Content="Next episode" Visibility="Collapsed"
                  Padding="16,10" CornerRadius="12" Click="OnNextEpisode"
                  AutomationProperties.AutomationId="EpisodeNextButton"
                  AutomationProperties.Name="Next episode" />
          <Button x:Name="EpisodeSkipButton" Content="Skip intro" Visibility="Collapsed"
                  Padding="20,10" CornerRadius="12" Style="{ThemeResource AccentButtonStyle}"
                  Click="OnSkipEpisodeSection" AutomationProperties.AutomationId="EpisodeSkipButton"
                  AutomationProperties.Name="Skip intro" />
        </StackPanel>

        <Border x:Name="StatsBox" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16" Padding="12,8" CornerRadius="8"
                Background="#C0080A09" Visibility="Collapsed" IsHitTestVisible="False">
          <TextBlock x:Name="Stats" Foreground="White" FontFamily="Cascadia Mono, Consolas" FontSize="12" AutomationProperties.AutomationId="Stats" />
        </Border>

        <Border x:Name="OsdBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="16" Padding="12,6" CornerRadius="8"
                Background="#B0080A09" Visibility="Collapsed" IsHitTestVisible="False">
          <TextBlock x:Name="Osd" Foreground="White" FontSize="18" AutomationProperties.AutomationId="Osd"
                     AutomationProperties.LiveSetting="Polite" />
        </Border>
      </Grid>

      <!-- The media library (LIB-05), over the picture while it is open; playback follows the library preference. -->
      <Grid x:Name="LibraryPane" Grid.Column="0" Visibility="Collapsed" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" SizeChanged="OnLibraryPaneSized"
            AutomationProperties.AutomationId="LibraryPane" AutomationProperties.Name="Library">
        <Grid.ColumnDefinitions>
          <ColumnDefinition x:Name="LibraryNavigationColumn" Width="200" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{ThemeResource LayerFillColorDefaultBrush}">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Button x:Name="LibraryNavigationToggle" Width="40" Height="40" Margin="8,8,8,0" HorizontalAlignment="Right"
                  Click="OnLibraryNavigationToggle" ToolTipService.ToolTip="Collapse library navigation"
                  AutomationProperties.AutomationId="LibraryNavigationToggle" AutomationProperties.Name="Collapse library navigation">
            <FontIcon x:Name="LibraryNavigationToggleIcon" Glyph="&#xE76B;" FontSize="16" />
          </Button>
          <ListView x:Name="LibrarySources" Grid.Row="1" SelectionMode="Single" Padding="0,8" Background="Transparent"
                    ItemTemplate="{StaticResource LibrarySourceTemplate}"
                    SelectionChanged="OnLibrarySourceChanged" AutomationProperties.AutomationId="LibrarySources" AutomationProperties.Name="Library views" />
        </Grid>

        <Grid Grid.Column="1">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>

          <!-- The view's banner: its artwork, blurred behind and sharp in front, its name, what it holds, and what to do with it. -->
          <Grid x:Name="LibraryHero" MinHeight="196" AutomationProperties.AutomationId="LibraryHero">
            <Image x:Name="LibraryHeroBackdrop" Height="196" VerticalAlignment="Top" Stretch="UniformToFill" Opacity="0.6">
              <Image.OpacityTransition><ScalarTransition Duration="0:0:0.25" /></Image.OpacityTransition>
            </Image>
            <!-- A title's own wide backdrop, fetched lazily at the banner's size, over the blurred artwork. The pictures take
                 the height of the words beside them (OnLibraryHeroSized), so a tall picture never stretches the banner. -->
            <Image x:Name="LibraryHeroWide" Height="196" VerticalAlignment="Top" Stretch="UniformToFill" Opacity="0">
              <Image.OpacityTransition><ScalarTransition Duration="0:0:0.25" /></Image.OpacityTransition>
            </Image>
            <Rectangle>
              <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                  <GradientStop Color="#40000000" Offset="0" />
                  <GradientStop Color="{ThemeResource SolidBackgroundFillColorBase}" Offset="1" />
                </LinearGradientBrush>
              </Rectangle.Fill>
            </Rectangle>
            <Grid x:Name="LibraryHeroContent" Padding="24,16,24,14" ColumnSpacing="22" SizeChanged="OnLibraryHeroSized">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Border x:Name="LibraryHeroArtBox" AutomationProperties.AutomationId="LibraryHeroArtBox" Width="150" Height="150" CornerRadius="12" VerticalAlignment="Bottom" Background="{ThemeResource LayerFillColorDefaultBrush}">
                <Grid>
                  <FontIcon x:Name="LibraryHeroGlyph" Glyph="&#xE8D6;" FontSize="56" Opacity="0.45" />
                  <Image x:Name="LibraryHeroArt" Stretch="UniformToFill" AutomationProperties.AutomationId="LibraryHeroArt">
                    <Image.OpacityTransition><ScalarTransition Duration="0:0:0.25" /></Image.OpacityTransition>
                  </Image>
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Spacing="2">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="LibraryBack" Visibility="Collapsed" Click="OnLibraryBack" AutomationProperties.AutomationId="LibraryBack" AutomationProperties.Name="Back"
                          ToolTipService.ToolTip="Back (Alt+Left)" Padding="10,5">
                    <Button.KeyboardAccelerators>
                      <KeyboardAccelerator Key="Left" Modifiers="Menu" />
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <FontIcon Glyph="&#xE72B;" FontSize="12" />
                      <TextBlock x:Name="LibraryBackText" Text="Back" />
                    </StackPanel>
                  </Button>
                  <TextBlock x:Name="LibraryKicker" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" CharacterSpacing="80"
                             Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.AutomationId="LibraryKicker" />
                </StackPanel>
                <TextBlock x:Name="LibraryTitle" Style="{ThemeResource TitleLargeTextBlockStyle}" TextTrimming="CharacterEllipsis" MaxLines="1"
                           AutomationProperties.AutomationId="LibraryTitle" />
                <TextBlock x:Name="LibrarySubtitle" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextTrimming="CharacterEllipsis"
                           AutomationProperties.AutomationId="LibrarySubtitle" />
                <!-- A title's details, each hidden when there is nothing to say: its facts or its makers, its synopsis and the synopsis's credit. -->
                <TextBlock x:Name="LibraryFacts" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxLines="2"
                           TextTrimming="CharacterEllipsis" MaxWidth="760" HorizontalAlignment="Left" AutomationProperties.AutomationId="LibraryFacts" />
                <TextBlock x:Name="LibraryOverview" Visibility="Collapsed" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" MaxWidth="760"
                           HorizontalAlignment="Left" Margin="0,6,0,0" AutomationProperties.AutomationId="LibraryOverview" />
                <HyperlinkButton x:Name="LibraryCredit" Visibility="Collapsed" Padding="0" FontSize="11" Margin="0,2,0,0"
                                 AutomationProperties.AutomationId="LibraryCredit" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                  <Button x:Name="LibraryPlay" Click="OnLibraryPlay" Style="{ThemeResource AccentButtonStyle}" AutomationProperties.AutomationId="LibraryPlay"
                          ToolTipService.ToolTip="Play the chosen items, or all of them (Enter)">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE768;" FontSize="14" /><TextBlock x:Name="LibraryPlayText" Text="Play" /></StackPanel>
                  </Button>
                  <Button x:Name="LibraryShuffle" Click="OnLibraryShuffle" AutomationProperties.AutomationId="LibraryShuffle" ToolTipService.ToolTip="Play the chosen items, or all of them, shuffled">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE8B1;" FontSize="14" /><TextBlock Text="Shuffle" /></StackPanel>
                  </Button>
                  <Button x:Name="LibraryEnqueue" Click="OnLibraryEnqueue" AutomationProperties.AutomationId="LibraryEnqueue" ToolTipService.ToolTip="Add the chosen items, or all of them, to the end of the playlist">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE710;" FontSize="14" /><TextBlock Text="Add to the playlist" /></StackPanel>
                  </Button>
                  <Button x:Name="LibraryTrailer" Visibility="Collapsed" Click="OnLibraryTrailer" AutomationProperties.AutomationId="LibraryTrailer" ToolTipService.ToolTip="Open the trailer in the browser">
                    <StackPanel Orientation="Horizontal" Spacing="6"><FontIcon Glyph="&#xE714;" FontSize="14" /><TextBlock Text="Watch trailer" /></StackPanel>
                  </Button>
                  <ComboBox x:Name="LibrarySeasonPicker" Visibility="Collapsed" MinWidth="140" SelectionChanged="OnLibrarySeasonPicked" AutomationProperties.AutomationId="LibrarySeasonPicker" AutomationProperties.Name="Season" />
                  <StackPanel x:Name="LibraryFolderActions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                    <Button x:Name="LibraryAddFolder" Content="Add folders..." Click="OnLibraryAddFolder" AutomationProperties.AutomationId="LibraryAddFolder" />
                    <Button x:Name="LibraryRemoveFolder" Content="Stop watching" Click="OnLibraryRemoveFolder" AutomationProperties.AutomationId="LibraryRemoveFolder"
                            ToolTipService.ToolTip="The library forgets the chosen folders; the files stay where they are" />
                    <Button x:Name="LibraryRescan" Content="Look again" Click="OnLibraryRescan" AutomationProperties.AutomationId="LibraryRescan"
                            ToolTipService.ToolTip="Look through every folder for files added, changed or removed" />
                    <Button x:Name="LibraryBackUp" Content="Back up..." Click="OnLibraryBackUp" AutomationProperties.AutomationId="LibraryBackUp"
                            ToolTipService.ToolTip="Keep the library, its play counts and your playlists in a folder you choose" />
                    <Button x:Name="LibraryRestore" Content="Bring back..." Click="OnLibraryRestore" AutomationProperties.AutomationId="LibraryRestore"
                            ToolTipService.ToolTip="Add a backup's folders, play counts and playlists to the library" />
                  </StackPanel>
                </StackPanel>
              </StackPanel>
            </Grid>
          </Grid>

          <!-- How the view is shown: its layout, order, grouping and card size, each kept per view. -->
          <Grid Grid.Row="1" Padding="24,6,24,8" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <DropDownButton x:Name="LibraryLookButton" AutomationProperties.AutomationId="LibraryLook" ToolTipService.ToolTip="How the view is laid out" />
            <DropDownButton x:Name="LibrarySortButton" Grid.Column="1" AutomationProperties.AutomationId="LibrarySort" ToolTipService.ToolTip="What the view is ordered by" />
            <DropDownButton x:Name="LibraryGroupButton" Grid.Column="2" AutomationProperties.AutomationId="LibraryGroup" ToolTipService.ToolTip="What the view is gathered under" />
            <DropDownButton x:Name="LibraryFilterButton" Grid.Column="3" AutomationProperties.AutomationId="LibraryFilter" AutomationProperties.Name="Filter by progress, type, folder or download" ToolTipService.ToolTip="Filter this view by progress, media type, folder or download" />
            <StackPanel x:Name="LibrarySizePanel" Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="8,0,0,0">
              <FontIcon Glyph="&#xE71E;" FontSize="12" Opacity="0.7" />
              <Slider x:Name="LibraryCardSize" Width="110" Minimum="120" Maximum="360" StepFrequency="10" VerticalAlignment="Center"
                      ValueChanged="OnLibraryCardSizeChanged" AutomationProperties.AutomationId="LibraryCardSize" AutomationProperties.Name="Card size" />
            </StackPanel>
            <TextBlock x:Name="LibraryStatus" Grid.Column="5" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" Margin="8,0" AutomationProperties.AutomationId="LibraryStatus"
                       AutomationProperties.HelpText="Library scan status" AutomationProperties.LiveSetting="Polite" />
            <!-- A compact, clickable job count. Open it for the real queue, filenames and progress. -->
            <DropDownButton x:Name="LibraryTranscription" Grid.Column="6" Visibility="Collapsed" MaxWidth="240"
                            AutomationProperties.AutomationId="LibraryTranscription" AutomationProperties.Name="Transcription queue"
                            ToolTipService.ToolTip="Open transcription queue and controls">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <FontIcon Glyph="&#xE8B7;" FontSize="14" />
                <TextBlock x:Name="LibraryTranscriptionText" TextTrimming="CharacterEllipsis" MaxWidth="185"
                           AutomationProperties.AutomationId="LibraryTranscriptionText" />
              </StackPanel>
              <DropDownButton.Flyout>
                <Flyout x:Name="TranscriptionDetails" Placement="BottomEdgeAlignedRight"
                        Opened="OnTranscriptionDetailsOpened" Closed="OnTranscriptionDetailsClosed">
                  <StackPanel Width="400" Spacing="12">
                    <Grid ColumnSpacing="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="Transcription queue" FontSize="17" FontWeight="SemiBold"
                                 AutomationProperties.HeadingLevel="Level2" />
                      <TextBlock x:Name="TranscriptionQueueCount" Grid.Column="1" VerticalAlignment="Center"
                                 Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                 AutomationProperties.AutomationId="TranscriptionQueueCount" />
                    </Grid>
                    <TextBlock x:Name="TranscriptionQueueSummary" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12"
                               AutomationProperties.AutomationId="TranscriptionQueueSummary" />
                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  AutomationProperties.Name="Files waiting for transcription">
                      <StackPanel x:Name="TranscriptionQueueRows" Spacing="6"
                                  AutomationProperties.AutomationId="TranscriptionQueueRows" />
                    </ScrollViewer>
                    <Grid ColumnSpacing="8">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                      </Grid.ColumnDefinitions>
                      <Button x:Name="TranscriptionPauseButton" Grid.Column="0" Content="Pause"
                              Click="OnTranscriptionPauseClick" AutomationProperties.AutomationId="TranscriptionPause" />
                      <Button x:Name="TranscriptionStopButton" Grid.Column="1" Content="Stop"
                              Click="OnTranscriptionStopClick" AutomationProperties.AutomationId="TranscriptionStop" />
                      <Button Grid.Column="2" Content="Settings" HorizontalAlignment="Right"
                              Click="OnTranscriptionSettingsClick" AutomationProperties.AutomationId="TranscriptionSettings" />
                    </Grid>
                  </StackPanel>
                </Flyout>
              </DropDownButton.Flyout>
            </DropDownButton>
            <TextBox x:Name="LibrarySearch" Grid.Column="7" Width="260" PlaceholderText="Search the library" TextChanged="OnLibrarySearchChanged" PreviewKeyDown="OnLibrarySearchPreviewKeyDown"
                     AutomationProperties.AutomationId="LibrarySearch" AutomationProperties.Name="Search the library" />
          </Grid>

          <ListView x:Name="LibraryList" Grid.Row="2" Padding="18,0,18,8" SelectionMode="Extended" IsItemClickEnabled="False" Tapped="OnLibraryTapped" DoubleTapped="OnLibraryDoubleTapped" PreviewKeyDown="OnLibraryKeyDown"
                     ScrollViewer.VerticalScrollMode="Enabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                    ItemTemplate="{StaticResource LibrarySongTemplate}" ItemsPanel="{StaticResource LibraryListPanel}"
                    AutomationProperties.AutomationId="LibraryList" AutomationProperties.Name="Songs, compact list" />

          <ItemsView x:Name="LibraryCollage" Grid.Row="2" Visibility="Collapsed" Padding="18,0,18,8"
                     SelectionMode="Extended"
                     Tapped="OnCollageTapped" DoubleTapped="OnCollageDoubleTapped" KeyDown="OnCollageKeyDown"
                     AutomationProperties.AutomationId="LibraryCollage" AutomationProperties.Name="Justified collage, select or open media">
            <ItemsView.Layout>
              <LinedFlowLayout ItemsStretch="Fill" LineHeight="180" LineSpacing="6" MinItemSpacing="6"
                               ItemsInfoRequested="OnCollageItemsInfoRequested" />
            </ItemsView.Layout>
          </ItemsView>

          <!-- Home: shelves of what to play next. -->
          <ScrollViewer x:Name="LibraryHome" Grid.Row="2" Visibility="Collapsed" VerticalScrollMode="Enabled" VerticalScrollBarVisibility="Auto"
                         AutomationProperties.AutomationId="LibraryHome">
            <StackPanel x:Name="LibraryShelves" Spacing="22" Padding="24,4,24,24" />
          </ScrollViewer>

          <StackPanel x:Name="LibraryEmpty" Grid.Row="2" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="12" MaxWidth="440">
            <TextBlock x:Name="LibraryEmptyText" TextWrapping="Wrap" TextAlignment="Center" AutomationProperties.AutomationId="LibraryEmptyText" />
            <StackPanel x:Name="LibraryFolderButtons" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8" />
          </StackPanel>
        </Grid>
        <!-- Words for what the library cannot do yet (a file still downloading): the player's own messages sit under the open library. -->
        <InfoBar x:Name="LibraryNotice" Grid.Column="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16" MaxWidth="560"
                 IsOpen="False" IsClosable="True" Severity="Informational" AutomationProperties.AutomationId="LibraryNotice" />
      </Grid>

      <Grid x:Name="PlaylistPane" Grid.Column="1" Width="344" Visibility="Collapsed" Padding="10,8"
            Background="{ThemeResource LayerFillColorDefaultBrush}" AutomationProperties.AutomationId="PlaylistPane">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="6,2,0,10" Spacing="2">
          <TextBlock Text="Playlist" Style="{ThemeResource SubtitleTextBlockStyle}" />
          <TextBlock Text="Drag to reorder · right-click for actions" FontSize="12"
                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
        </StackPanel>
        <Grid Grid.Row="1">
        <ListView x:Name="PlaylistView" SelectionMode="Extended" IsItemClickEnabled="False"
                  CanDragItems="True" CanReorderItems="True" AllowDrop="True" ReorderMode="Enabled"
                  DragItemsStarting="OnPlaylistDragItemsStarting" DragItemsCompleted="OnPlaylistDragItemsCompleted"
                  Tapped="OnPlaylistTapped" DoubleTapped="OnPlaylistDoubleTapped" RightTapped="OnPlaylistRightTapped" KeyDown="OnPlaylistKeyDown"
                  HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollMode="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  AutomationProperties.AutomationId="PlaylistView" AutomationProperties.Name="Playlist, drag entries to reorder">
          <ListView.ItemTemplate>
            <DataTemplate x:DataType="local:PlaylistRow">
              <Grid ColumnSpacing="8" Padding="2,5,8,5" MinHeight="58" Opacity="{x:Bind Opacity}"
                    ToolTipService.ToolTip="{x:Bind Title}" AutomationProperties.Name="{x:Bind AccessibleName}">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="16" />
                  <ColumnDefinition Width="3" />
                  <ColumnDefinition Width="64" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="⠿" FontSize="16" Opacity="0.42" VerticalAlignment="Center" HorizontalAlignment="Center"
                           ToolTipService.ToolTip="Drag to reorder" AutomationProperties.Name="Drag to reorder" />
                <Border Grid.Column="1" Width="3" Margin="0,3,0,3" CornerRadius="2" Background="{ThemeResource AccentFillColorDefaultBrush}"
                        Visibility="{x:Bind CurrentVisibility}" />
                <Border Grid.Column="2" Width="64" Height="40" CornerRadius="5" Background="{ThemeResource LayerFillColorDefaultBrush}">
                  <Grid>
                    <TextBlock Text="{x:Bind Placeholder}" FontSize="16" Opacity="0.38" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Image Source="{x:Bind Picture, Mode=OneWay}" Stretch="UniformToFill" />
                  </Grid>
                </Border>
                <Grid Grid.Column="3" RowSpacing="2" VerticalAlignment="Center" MinWidth="0">
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>
                  <TextBlock Text="{x:Bind Title}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                  <Grid Grid.Row="1" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Playing" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                               Visibility="{x:Bind CurrentVisibility}" />
                    <TextBlock Grid.Column="1" Text="{x:Bind Secondary}" FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind SecondaryVisibility}" />
                    <TextBlock Grid.Column="2" Text="Missing" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                               Visibility="{x:Bind MissingVisibility}" />
                  </Grid>
                </Grid>
              </Grid>
            </DataTemplate>
          </ListView.ItemTemplate>
        </ListView>
          <StackPanel x:Name="PlaylistEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6" MaxWidth="250">
            <TextBlock Text="Your playlist is empty" Style="{ThemeResource BodyStrongTextBlockStyle}" TextAlignment="Center" />
            <TextBlock Text="Open or drop media here to start a playlist." TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
          </StackPanel>
        </Grid>
      </Grid>
      <!-- A downloaded update, or a newer version to decide about (TOOL-09): a compact card in the
           corner, never over the middle of the picture and never while a video plays. Escape inside
           it is "Later: tomorrow". -->
      <Border x:Name="UpdateCard" Grid.Column="0" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top"
              Margin="16" MaxWidth="400" Padding="16,14" CornerRadius="8" BorderThickness="1"
              Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
              AutomationProperties.AutomationId="UpdateCard" AutomationProperties.Name="Update"
              AutomationProperties.LandmarkType="Custom" AutomationProperties.LocalizedLandmarkType="Update">
        <StackPanel Spacing="12">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon x:Name="UpdateCardReadyIcon" Glyph="&#xE777;" FontSize="20" VerticalAlignment="Top" Margin="0,2,0,0"
                      Foreground="{ThemeResource SystemFillColorSuccessBrush}" AutomationProperties.AccessibilityView="Raw" />
            <FontIcon x:Name="UpdateCardAvailableIcon" Glyph="&#xE896;" FontSize="20" VerticalAlignment="Top" Margin="0,2,0,0" Visibility="Collapsed"
                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock x:Name="UpdateCardText" Grid.Column="1" TextWrapping="Wrap" AutomationProperties.AutomationId="UpdateCardText" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button x:Name="UpdateCardAction" Style="{StaticResource AccentButtonStyle}" Click="OnUpdateCardActionClick"
                    AutomationProperties.AutomationId="UpdateCardAction" />
            <DropDownButton x:Name="UpdateCardLater" Content="Later" AutomationProperties.AutomationId="UpdateCardLater"
                            ToolTipService.ToolTip="Remind me later, install at another time, or skip this version" />
          </StackPanel>
          <Expander x:Name="UpdateCardWhatsNew" Header="What's new" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                    AutomationProperties.AutomationId="UpdateCardWhatsNew">
            <StackPanel Spacing="6">
              <ScrollViewer MaxHeight="220" VerticalScrollBarVisibility="Auto">
                <RichTextBlock x:Name="UpdateCardNotes" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="UpdateCardNotes"
                               AutomationProperties.Name="What's new" />
              </ScrollViewer>
              <HyperlinkButton Content="Open the release page" Click="OnUpdateReleasePageClick" AutomationProperties.AutomationId="UpdateCardReleasePage" />
            </StackPanel>
          </Expander>
        </StackPanel>
      </Border>
    </Grid>

    <Grid x:Name="Controls" Grid.Row="2" Padding="16,10,16,12" ColumnSpacing="12" RowSpacing="8" VerticalAlignment="Bottom"
          Background="{ThemeResource LayerFillColorAltBrush}">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button x:Name="StartOverButton" Content="Start over" Click="OnStartOver" IsEnabled="False"
                ToolTipService.ToolTip="Start this media from the beginning"
                AutomationProperties.AutomationId="StartOverButton" AutomationProperties.Name="Start this media from the beginning" />
        <TextBlock x:Name="Elapsed" Text="0:00" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas"
                   AutomationProperties.AutomationId="Elapsed" />
      </StackPanel>
      <Grid x:Name="SeekArea" Grid.Row="0" Grid.Column="1" SizeChanged="OnSeekAreaSizeChanged"
            PointerMoved="OnSeekAreaPointerMoved" PointerExited="OnSeekAreaPointerExited">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Slider x:Name="SeekBar" Minimum="0" Maximum="1" StepFrequency="0.1" IsEnabled="False" IsThumbToolTipEnabled="False" MinHeight="32"
                ValueChanged="OnSeekBarChanged" IsTabStop="True" AutomationProperties.AutomationId="SeekBar" AutomationProperties.Name="Position" />
        <!-- A second aligned rail for transcript coverage. The whole width maps to the same
             timeline as SeekBar; labels are on their own row and never shift the spans. -->
        <Grid x:Name="TranscriptRail" Grid.Row="1" Margin="14,0,14,3" Visibility="Collapsed"
              AutomationProperties.AutomationId="TranscriptRail" AutomationProperties.Name="Transcript coverage">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <Grid Height="6" VerticalAlignment="Center" IsHitTestVisible="False">
            <Border CornerRadius="3" Background="{ThemeResource ControlFillColorSecondaryBrush}" />
            <Canvas x:Name="SubtitleBuffer" Height="6" IsHitTestVisible="False"
                    AutomationProperties.AutomationId="SubtitleBuffer" AutomationProperties.Name="Subtitles ready" />
          </Grid>
          <Grid Grid.Row="1" Margin="0,3,0,0">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="CAPTIONS" FontSize="10" CharacterSpacing="65" VerticalAlignment="Center"
                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                         AutomationProperties.AccessibilityView="Raw" />
              <DropDownButton x:Name="TranscriptModelButton" Content="Default" Padding="5,0" MinHeight="20" FontSize="10"
                              AutomationProperties.AutomationId="TranscriptModelButton" AutomationProperties.Name="Transcription quality">
                <DropDownButton.Flyout>
                  <MenuFlyout>
                    <ToggleMenuFlyoutItem x:Name="TranscriptModelFast" AutomationProperties.AutomationId="TranscriptModelFast" Text="Fast · quickest, may miss more words" Tag="0" Click="OnTranscriptModelClick" />
                    <ToggleMenuFlyoutItem x:Name="TranscriptModelDefault" AutomationProperties.AutomationId="TranscriptModelDefault" Text="Default · balanced speed and accuracy" Tag="1" Click="OnTranscriptModelClick" />
                    <ToggleMenuFlyoutItem x:Name="TranscriptModelBest" AutomationProperties.AutomationId="TranscriptModelBest" Text="Best · most accurate, longer preparation" Tag="2" Click="OnTranscriptModelClick" />
                  </MenuFlyout>
                </DropDownButton.Flyout>
              </DropDownButton>
            </StackPanel>
            <TextBlock x:Name="SubtitleBufferState" HorizontalAlignment="Right" TextAlignment="Right"
                       FontSize="11" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       AutomationProperties.AutomationId="SubtitleBufferState" AutomationProperties.LiveSetting="Off" />
          </Grid>
        </Grid>
        <!-- Intro and credits as bands on the rail: filled when saved, outlined when detected. -->
        <Canvas x:Name="SectionMarkers" Height="28" VerticalAlignment="Center" IsHitTestVisible="False"
                AutomationProperties.AutomationId="SectionMarkers" AutomationProperties.Name="No intro or credits marked" />
        <!-- Bookmark buttons sit above the rail. Their transparent 16-pixel hit targets are much
             easier to point at than their precise 3-pixel marks. -->
        <Canvas x:Name="BookmarkMarkers" Height="28" VerticalAlignment="Center" AutomationProperties.AutomationId="BookmarkMarkers"
                AutomationProperties.Name="Bookmarks on the timeline" />
        <Border x:Name="SeekPreview" Width="192" Padding="6" CornerRadius="8" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                Margin="0,0,0,30" Background="#E6101110" BorderBrush="#55FFFFFF" BorderThickness="1" Visibility="Collapsed"
                IsHitTestVisible="False" Canvas.ZIndex="20" AutomationProperties.AutomationId="SeekPreview" AutomationProperties.Name="Timeline preview">
          <StackPanel Spacing="5">
            <Border x:Name="SeekPreviewPicture" Width="178" Height="100" CornerRadius="5" Background="Black" Visibility="Collapsed">
              <Image x:Name="SeekPreviewImage" Stretch="UniformToFill" />
            </Border>
            <TextBlock x:Name="SeekPreviewTime" Foreground="White" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold"
                       HorizontalAlignment="Center" AutomationProperties.AutomationId="SeekPreviewTime" />
            <TextBlock x:Name="SeekPreviewSubtitles" Foreground="#C8FFFFFF" FontSize="11" HorizontalAlignment="Center" Visibility="Collapsed"
                       AutomationProperties.AutomationId="SeekPreviewSubtitles" />
          </StackPanel>
        </Border>
      </Grid>
      <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <DropDownButton x:Name="MovieVersionButton" Visibility="Collapsed" Content="Versions" Padding="7,2" MinHeight="26"
                        AutomationProperties.AutomationId="MovieVersionButton" AutomationProperties.Name="Choose movie resolution">
          <DropDownButton.Flyout>
            <MenuFlyout x:Name="MovieVersionMenu" />
          </DropDownButton.Flyout>
        </DropDownButton>
        <TextBlock x:Name="Remaining" Text="0:00" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas"
                   Tapped="OnRemainingTapped" AutomationProperties.AutomationId="Remaining" />
      </StackPanel>

      <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" ColumnSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Button x:Name="MinimalInterfaceButton" Visibility="Collapsed" Click="OnRestoreFullInterface"
                  AutomationProperties.AutomationId="MinimalInterfaceButton" AutomationProperties.Name="Restore full interface"
                  ToolTipService.ToolTip="Restore the full interface">
            <FontIcon Glyph="&#xE8A7;" />
          </Button>
          <Button x:Name="PreviousButton" Click="OnPrevious" AutomationProperties.AutomationId="PreviousButton" AutomationProperties.Name="Previous">
            <FontIcon Glyph="&#xE892;" />
          </Button>
          <Button x:Name="PlayPauseButton" Click="OnPlayPause" AutomationProperties.AutomationId="PlayPauseButton" AutomationProperties.Name="Play">
            <FontIcon x:Name="PlayPauseIcon" Glyph="&#xE768;" />
          </Button>
          <Button x:Name="StopButton" Click="OnStop" AutomationProperties.AutomationId="StopButton" AutomationProperties.Name="Stop">
            <FontIcon Glyph="&#xE71A;" />
          </Button>
          <Button x:Name="NextButton" Click="OnNext" AutomationProperties.AutomationId="NextButton" AutomationProperties.Name="Next">
            <FontIcon Glyph="&#xE893;" />
          </Button>
          <AppBarSeparator x:Name="TransportSeparator" />
          <ToggleButton x:Name="ShuffleButton" Click="OnShuffle" AutomationProperties.AutomationId="ShuffleButton" AutomationProperties.Name="Shuffle">
            <FontIcon Glyph="&#xE8B1;" />
          </ToggleButton>
          <ToggleButton x:Name="RepeatButton" Click="OnRepeat" AutomationProperties.AutomationId="RepeatButton" AutomationProperties.Name="Repeat off">
            <FontIcon x:Name="RepeatIcon" Glyph="&#xE8EE;" />
          </ToggleButton>
          <ToggleButton x:Name="PlaylistButton" Click="OnTogglePlaylist" AutomationProperties.AutomationId="PlaylistButton" AutomationProperties.Name="Playlist">
            <FontIcon Glyph="&#xE8FD;" />
          </ToggleButton>
          <ToggleButton x:Name="LibraryButton" Click="OnToggleLibrary" AutomationProperties.AutomationId="LibraryButton" AutomationProperties.Name="Library">
            <FontIcon Glyph="&#xE8F1;" />
          </ToggleButton>
          <Button x:Name="FullScreenButton" Click="OnFullScreen" AutomationProperties.AutomationId="FullScreenButton" AutomationProperties.Name="Full screen">
            <FontIcon x:Name="FullScreenIcon" Glyph="&#xE740;" />
          </Button>
        </StackPanel>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1" MaxWidth="480" HorizontalAlignment="Stretch">
          <TextBlock x:Name="NowPlaying" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                     AutomationProperties.AutomationId="NowPlaying" />
          <TextBlock x:Name="NowPlayingContext" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                     TextTrimming="CharacterEllipsis" Visibility="Collapsed"
                     AutomationProperties.AutomationId="NowPlayingContext" />
        </StackPanel>
      </Grid>

      <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="4">
        <!-- Updates (TOOL-09): a quiet indicator while a download runs in the background or an update
             waits; it opens the update panel with the live state. -->
        <Button x:Name="UpdateIndicator" Visibility="Collapsed" VerticalAlignment="Center" Padding="7,5"
                AutomationProperties.AutomationId="UpdateIndicator" AutomationProperties.Name="Update">
          <Grid Width="22" Height="22">
            <ProgressRing x:Name="UpdateIndicatorRing" Width="22" Height="22" IsActive="False" IsIndeterminate="False" Maximum="100"
                          IsHitTestVisible="False" AutomationProperties.AccessibilityView="Raw" />
            <FontIcon x:Name="UpdateIndicatorIcon" Glyph="&#xE896;" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                      AutomationProperties.AccessibilityView="Raw" />
            <InfoBadge x:Name="UpdateBadgeAttention" Style="{StaticResource AttentionDotInfoBadgeStyle}" Visibility="Collapsed"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-2,-4,0" AutomationProperties.AccessibilityView="Raw" />
            <InfoBadge x:Name="UpdateBadgeSuccess" Style="{StaticResource SuccessIconInfoBadgeStyle}" Visibility="Collapsed"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-6,0" AutomationProperties.AccessibilityView="Raw" />
            <InfoBadge x:Name="UpdateBadgeCritical" Style="{StaticResource CriticalIconInfoBadgeStyle}" Visibility="Collapsed"
                       HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-4,-6,0" AutomationProperties.AccessibilityView="Raw" />
          </Grid>
          <Button.Flyout>
            <Flyout x:Name="UpdateFlyout" Placement="TopEdgeAlignedRight" Opened="OnUpdateFlyoutOpened" Closed="OnUpdateFlyoutClosed">
              <StackPanel Width="360" Spacing="10" AutomationProperties.AutomationId="UpdatePanel" AutomationProperties.Name="Update">
                <TextBlock x:Name="UpdatePanelTitle" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap"
                           AutomationProperties.AutomationId="UpdatePanelTitle" AutomationProperties.HeadingLevel="Level1" />
                <Grid>
                  <Border x:Name="UpdatePanelErrorBack" Visibility="Collapsed" CornerRadius="4"
                          Background="{ThemeResource SystemFillColorCriticalBackgroundBrush}" />
                  <Grid x:Name="UpdatePanelStatusBox" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="Auto" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon x:Name="UpdatePanelErrorIcon" Visibility="Collapsed" Glyph="&#xEA39;" FontSize="16" VerticalAlignment="Top" Margin="0,2,0,0"
                              Foreground="{ThemeResource SystemFillColorCriticalBrush}" AutomationProperties.AccessibilityView="Raw" />
                    <TextBlock x:Name="UpdatePanelStatus" Grid.Column="1" TextWrapping="Wrap" AutomationProperties.AutomationId="UpdatePanelStatus" />
                  </Grid>
                </Grid>
                <ProgressBar x:Name="UpdatePanelProgress" Maximum="100" Visibility="Collapsed"
                             AutomationProperties.AutomationId="UpdatePanelProgress" AutomationProperties.Name="Download progress" />
                <TextBlock x:Name="UpdatePanelNote" TextWrapping="Wrap" Visibility="Collapsed" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           AutomationProperties.AutomationId="UpdatePanelNote" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button x:Name="UpdateDownloadButton" Content="Download" Click="OnUpdateDownloadClick" Visibility="Collapsed"
                          AutomationProperties.AutomationId="UpdateDownloadButton"
                          ToolTipService.ToolTip="Download in the background, then choose when to install" />
                  <Button x:Name="UpdateResumeButton" Content="Resume download" Click="OnUpdateResumeClick" Visibility="Collapsed"
                          AutomationProperties.AutomationId="UpdateResumeButton" />
                  <Button x:Name="UpdateRetryButton" Content="Retry" Click="OnUpdateResumeClick" Visibility="Collapsed"
                          AutomationProperties.AutomationId="UpdateRetryButton" AutomationProperties.Name="Retry the download" />
                  <Button x:Name="UpdateRestartButton" Content="Restart now" Click="OnUpdateRestartClick" Visibility="Collapsed"
                          AutomationProperties.AutomationId="UpdateRestartButton"
                          ToolTipService.ToolTip="Install now; rexplayer reopens with your queue and place, paused" />
                  <Button x:Name="UpdateCheckAgainButton" Content="Check again" Click="OnUpdateCheckAgainClick" Visibility="Collapsed"
                          AutomationProperties.AutomationId="UpdateCheckAgainButton" />
                  <Button x:Name="UpdatePauseButton" Content="Pause download" Click="OnUpdatePauseClick" Visibility="Collapsed"
                          AutomationProperties.AutomationId="UpdatePauseButton" />
                  <DropDownButton x:Name="UpdateLaterButton" Content="Later" Visibility="Collapsed" AutomationProperties.AutomationId="UpdateLaterButton"
                                  ToolTipService.ToolTip="Remind me later, install at another time, or skip this version" />
                  <Button x:Name="UpdateCancelButton" Content="Cancel download" Click="OnUpdateCancelClick" Visibility="Collapsed"
                          AutomationProperties.AutomationId="UpdateCancelButton" />
                </StackPanel>
                <Expander x:Name="UpdateWhatsNew" Header="What's new" IsExpanded="False" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                          AutomationProperties.AutomationId="UpdateWhatsNew">
                  <StackPanel Spacing="6">
                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                      <RichTextBlock x:Name="UpdateNotes" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="UpdateNotes"
                                     AutomationProperties.Name="What's new" />
                    </ScrollViewer>
                    <HyperlinkButton x:Name="UpdateReleasePage" Content="Open the release page" Click="OnUpdateReleasePageClick"
                                     AutomationProperties.AutomationId="UpdateReleasePage" />
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Flyout>
          </Button.Flyout>
        </Button>
        <Button x:Name="SpeedButton" Content="1×" MinWidth="52" Click="OnSpeedButton" VerticalAlignment="Center"
                AutomationProperties.AutomationId="SpeedButton" AutomationProperties.Name="Playback speed, 1×"
                ToolTipService.ToolTip="Choose playback speed" />
        <Button x:Name="MuteButton" Click="OnMute" AutomationProperties.AutomationId="MuteButton" AutomationProperties.Name="Mute">
          <FontIcon x:Name="MuteIcon" Glyph="&#xE767;" />
        </Button>
        <Slider x:Name="VolumeBar" Width="120" Minimum="0" Maximum="200" StepFrequency="1" VerticalAlignment="Center" ValueChanged="OnVolumeChanged"
                AutomationProperties.AutomationId="VolumeBar" AutomationProperties.Name="Volume" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Rex.Media.Interop</RootNamespace>
    <!-- CsWin32 emits pointer-based signatures; this is the one project allowed to compile them. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Generated bindings are not documented line by line. -->
    <NoWarn>$(NoWarn);CS1573</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
  </ItemGroup>

</Project>

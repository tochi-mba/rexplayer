<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Product. The runtime closure of rexplayer is the .NET base library and the Windows App SDK,
       nothing else (ADR-002). CsWin32 is a compile-time source generator; it ships no code of its
       own. RepositoryTests fail if this group gains an entry the ADR does not list. -->
  <ItemGroup Label="Product">
    <PackageVersion Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <PackageVersion Include="Microsoft.Windows.CsWin32" Version="0.3.346" />
  </ItemGroup>

  <!-- Tests and developer tools. None of these reach the installer. -->
  <ItemGroup Label="Test">
    <PackageVersion Include="xunit.v3" Version="4.0.1" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2" />
    <PackageVersion Include="System.Reflection.MetadataLoadContext" Version="10.0.0" />
    <!-- Test-only: coverage-guided fuzzing of the parsers (tests/Rex.Fuzz, fuzz.yml). -->
    <PackageVersion Include="SharpFuzz" Version="2.3.0" />
  </ItemGroup>

</Project>
